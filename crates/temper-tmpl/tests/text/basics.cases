# Subset A in canonical text: each case reads, writes back, and
# validates without problems, unless a section below it says otherwise.
# The format is described in tests/text.rs.

=== formats.md's example
tmpl 1 model 1 library example 0.1.0

module example#0 {
  var calls#1: Int32;

  export fn clamp#2(n#3: Int32, limit#4: Int32): Int32 {
    calls#1 = %Int32.add(calls#1, 1);
    let low#5: Int32 = (if (%Int32.lt(n#3, 0)) (value { %console.log("negative"); 0 }): Int32 else n#3): Int32;
    if (%Int32.gt(low#5, limit#4)) {
      return limit#4;
    } else {
      return low#5;
    }
  }

  init {
    init calls#1 = 0;
    %console.log(%Int32.toString(clamp#2(5, 3)));
  }
}

