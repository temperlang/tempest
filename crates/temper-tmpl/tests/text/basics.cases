=== loops, labels, and jumps
tmpl 1 model 1 library loops 0.1.0

uses `temper-core`#11 0.1.0 {
  class Int32#12 {
    connected method toString#13(radix?: Int32): String;
  }
  interface Console#14 {
    connected method log#15(message: String): Void;
  }
  connected fn getConsole#16(name?: String): Console#14;
}

module loops#0 {
  let ~console#17: Console#14;

  fn sum#1(limit#2: Int32): Int32 throws Bubble {
    var total#3: Int32 = 0;
    var i#4: Int32 = 0;
    outer#5: while (true) {
      if (%Int32.ge(i#4, limit#2)) {
        break outer#5;
      }
      i#4 = %Int32.add(i#4, 1);
      ~loop#6: while (%Int32.lt(total#3, 100)) {
        total#3 = %Int32.add(total#3, i#4);
        if (%Int32.eq(%Int32.mod(total#3, 2)^, 0)) {
          continue outer#5;
        }
        break ~loop#6;
      }
    }
    return total#3;
  }

  fn countdown#7(n#8: Int32): Void {
    var left#9: Int32 = n#8;
    ~loop#10: do {
      ~console#17.log#15(left#9.toString#13(omitted));
      left#9 = %Int32.sub(left#9, 1);
    } while (%Int32.gt(left#9, 0));
  }

  init {
    init ~console#17 = getConsole#16(omitted);
  }
}

