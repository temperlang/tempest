module named#0 {
  /// How many times `next` ran.
  ///
  /// Never negative.
  export var count#1: Int32;

  /// The next count.
  export fn next#2(): Int32 {
    count#1 = %Int32.add(count#1, 1);
    let ~count|int32#3: Int32 = count#1;
    ~result#4: while (false) {}
    return ~count#3;
  }

  fn `odd name`#5(for#6: Int32, `a\`b`#7: Int32): Void {}

  init {
    init count#1 = 0;
    `odd name`#5(next#2(), 2);
  }
}

