module literals#0 {
  let ~console#19: Console#16;

  let small#1: Int32;

  let big#2: Int64;

  let x#3: Float64;

  let text#4: String;

  let yes#5: Boolean;

  let kind#20: Type;

  init {
    init ~console#19 = getConsole#18(omitted);
    init small#1 = -2147483648;
    init big#2 = -9223372036854775808i64;
    init x#3 = %Float64.add(%Float64.add(1.5, -0.0), %Float64.add(1.0e16, 1.0e-7));
    ~console#19.log#17(%Float64.add(nan, %Float64.add(inf, -inf)).toString#15());
    init text#4 = "quote \" backslash \\ newline \n tab \t bell \u{7} é 😀";
    init yes#5 = %Boolean.not(false) || true && false;
    ~console#19.log#17(%Boolean.eq(%Boolean.not(yes#5), true).toString#8());
    ~console#19.log#17(%String.cat(text#4, big#2.toString#12(omitted)));
    ~console#19.log#17(x#3.toInt32#14()^.toString#10(omitted));
    ~console#19.log#17((-0.5).toString#15());
    ~console#19.log#17(-1.toString#10(2));
    ~console#19.log#17(5i64.toString#12(omitted));
    ~console#19.log#17((true || false).toString#8());
    init kind#20 = typeValue(Void);
  }
}

=== else if, and grouping of && and ||
tmpl 1 model 1 library logic 0.1.0

module logic#0 {
  fn sign#1(n#2: Int32): String {
    if (%Int32.lt(n#2, 0)) {
      return "negative";
    } else if (%Int32.eq(n#2, 0)) {
      return "zero";
    } else {
      return "positive";
    }
  }

  fn mix#3(a#4: Boolean, b#5: Boolean, c#6: Boolean): Boolean {
    let x#7: Boolean = a#4 && b#5 || c#6;
    let y#8: Boolean = a#4 && (b#5 || c#6);
    let z#9: Boolean = a#4 || (b#5 || c#6);
    let w#10: Boolean = a#4 && (b#5 && c#6);
    return x#7 && y#8 && z#9 || w#10;
  }

  init {}
}

