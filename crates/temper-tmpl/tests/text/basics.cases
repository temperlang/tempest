=== hand-written: comments, layout, gaps in ids, and redundant types
tmpl 1 model 1 library hand 0.1.0
// Comments and layout are free; ids needn't be dense.
module hand#0 { fn f#5(a#9: Int32): Int32 {
    let b#12: Int32 = (%Int32.add(a#9, 1)): Int32;  // a redundant type
    return (b#12);
} init { f#5(1); } }
--- canonical
tmpl 1 model 1 library hand 0.1.0

module hand#0 {
  fn f#5(a#9: Int32): Int32 {
    let b#12: Int32 = %Int32.add(a#9, 1);
    return b#12;
  }

  init {
    f#5(1);
  }
}
