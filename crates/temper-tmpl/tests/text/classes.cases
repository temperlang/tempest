}

module more#0 {
  /// Something with a name.
  interface Tagged#11 extends Named#2 {
    abstract set tag#12(value#13: String): Void;
    protected method shout#14(): String {
      return %String.cat(((upcast(this)): Named#2).name#3(), "!");
    }
  }

  export class Tag#15 extends Tagged#11, Named#2 {
    /// The tag's text.
    var text#16: String;
    constructor constructor#17(): Tag#15 {
      this.text#16 = "";
    }
    get name#18(): String {
      return this.text#16;
    }
    set name#19(value#20: String): Void {
      this.text#16 = value#20;
    }
    set tag#21(value#22: String): Void {
      this.text#16 = (value { this.text#16 = value#22; ((upcast(this)): Tagged#11).shout#14() }): String;
    }
  }

  fn check#23(b#24: Box#5, t#25: Tag#15): Boolean throws Bubble {
    b#24.label#7 = "x";
    t#25.name#19("y");
    let n#26: Named#2 = (upcast(t#25)): Named#2;
    let again#27: Tag#15 = (as(n#26)^): Tag#15;
    let made#28: Box#5 = make#10()^;
    let s#29: String = ((upcast(t#25)): Named#2).name#3();
    if (is(n#26, Tag#15)) {
      ((downcast(n#26)): Tag#15).text#16 = s#29;
    }
    return identical(again#27, t#25) && is((upcast(b#24)): Named#2, Box#5) && %Int32.eq(empty#8.item#6, made#28.item#6);
  }

  init {
    let box#30: Box#5 = new constructor#9(1);
    box#30.label#7 = new constructor#17().text#16;
  }
}

=== class members out of place (C1)
tmpl 1 model 1 library bad 0.1.0

module bad#0 {
  interface I#1 {
    let f#2: Int32;
    abstract get g#3(): Int32;
  }

  class D#4 {}

  class C#5 extends D#4, I#1 {
    let x#6: Int32;
    abstract method m#7(): Void;
    constructor make#8(): Int32 {}
    set v#9(a#10: Int32, b#11: Int32): Void {}
    get g#12(): Int32 {
      let other#13: D#4 = (this): D#4;
      return 1;
    }
    static fn h#14(): C#5 {
      return (this): C#5;
    }
  }

  init {}
}
--- problems
D2 #2: a field can't be owned by #1
C1 #5: D#4 can't be its supertype
C1 @6: only an interface's or connected methods may have no body
C1 #8: a constructor's result is its class
C1 #9: a setter takes one argument and returns Void
C1 @16: this is C#5
C1 @22: this outside a member

