=== fields, statics, and conversions (C3)
tmpl 1 model 1 library conv 0.1.0

module conv#0 {
  interface I#1 {}

  class C#2 extends I#1 {
    let fixed#3: Int32;
    static let shared#4: Int32;
    constructor constructor#5(c#6: C#2): C#2 {
      this.fixed#3 = 1;
      c#6.fixed#3 = 2;
    }
    method reset#7(): Void {
      this.fixed#3 = 0;
    }
  }

  fn f#8(c#9: C#2, i#10: I#1): Boolean throws Bubble {
    let same#11: C#2 = (upcast(c#9)): C#2;
    let down#12: C#2 = (downcast(c#9)): C#2;
    let up#13: I#1 = (as(c#9)^): I#1;
    let unmarked#14: C#2 = (as(i#10)): C#2;
    return is(1, C#2) && is(c#9, Int32) && identical(1, c#9);
  }

  init {
    init shared#4 = 1;
  }
}

module other#15 {
  init {
    init shared#4 = 2;
  }
}
--- problems
C3 @10: fixed#3 isn't a var, so only its class's constructor may set it, on this
C3 @15: fixed#3 isn't a var, so only its class's constructor may set it, on this
C3 @23: C#2 isn't a proper subtype of C#2
C3 @26: C#2 isn't a proper subtype of C#2
C3 @29: I#1 isn't a proper subtype of C#2
F3 @32: as may bubble, but isn't marked
C3 @38: the value checked is Int32, not a class or interface
C3 @39: the type checked is Int32, not a class or interface
C3 @42: an operand of identical is Int32, not a class or interface
C3 @48: shared#4 is another module's

