# Programs that read but break the validator's rules. Problems show as
# `RULE @n: message`, where `@n` is a node's number in writing order
# (preorder, as the spans section numbers them) and `#n` a declaration.
# The format is described in tests/text.rs.

=== wrong types (T3)
tmpl 1 model 1 library types 0.1.0

module types#0 {
  fn log#99(s#96: String): Void {}

  fn str#98(n#95: Int32): String {
    return "n";
  }

  fn f#1(a#2: Int32, b#3: String): Int32 {
    let c#4: Int64 = a#2;
    if (a#2) {}
    log#99(f#1(b#3, a#2));
    log#99(str#98(f#1(1)));
    return b#3;
  }

  init {}
}
--- problems
T3 @13: the initializer is Int32, but should be Int64
T3 @15: the condition is Int32, but should be Boolean
T3 @19: argument 1 is Int32, but should be String
T3 @20: argument 1 is String, but should be Int32
T3 @21: argument 2 is Int32, but should be String
T3 @25: f#1 takes 2 arguments, not 1
T3 @28: the returned value is String, but should be Int32

=== scopes and labels (R2, R3, R4)
tmpl 1 model 1 library scopes 0.1.0

module scopes#0 {
  fn log#99(s#96: String): Void {}

  fn str#98(n#95: Int32): String {
    return "n";
  }

  fn f#1(a#2: Int32): Void {
    {
      let inner#3: Int32 = 1;
    }
    log#99(str#98(inner#3));
    a#2 = 2;
    first#4: while (true) {
      break first#4;
    }
    second#5: while (true) {
      break first#4;
    }
    break a#2;
  }

  fn g#6(): Int32 {
    return a#2;
  }

  init {}
}
--- problems
R3 @17: inner#3 isn't in scope here
R6 @18: a#2 isn't a var
R4 @27: first#4 isn't an enclosing loop
R2 @28: Break needs a label, not a#2, a parameter
R3 @32: a#2 isn't in scope here

=== definite assignment (R5, R6)
tmpl 1 model 1 library assigned 0.1.0

module assigned#0 {
  fn log#99(s#96: String): Void {}

  fn str#98(n#95: Int32): String {
    return "n";
  }

  fn f#1(flag#2: Boolean): Void {
    let a#3: Int32;
    if (flag#2) {
      a#3 = 1;
    }
    log#99(str#98(a#3));
    let b#4: Int32 = 1;
    b#4 = 2;
    let c#5: Int32;
    ~loop#6: while (flag#2) {
      c#5 = 3;
    }
    let d#7: Int32;
    if (flag#2) {
      d#7 = 1;
    } else {
      d#7 = 2;
    }
    log#99(str#98(d#7));
    ~loop#8: while (flag#2) {
      let e#9: Int32;
      e#9 = 1;
    }
  }

  init {}
}
--- problems
R5 @20: a#3 may be read before it's assigned
R6 @23: b#4 isn't a var, but may be assigned twice
R6 @29: c#5 isn't a var, but may be assigned twice

=== returns and bubbling (F1, F2, F4)
tmpl 1 model 1 library flow 0.1.0

module flow#0 {
  fn int#97(s#94: String): Int32 throws Bubble {
    return 0;
  }

  fn falls#1(flag#2: Boolean): Int32 {
    if (flag#2) {
      return 1;
    }
  }

  fn loops#3(): Int32 {
    ~loop#4: while (true) {}
  }

  fn breaks#5(): Int32 {
    ~loop#6: while (true) {
      break ~loop#6;
    }
  }

  fn returns#7(): Void {
    return 1;
  }

  fn needs#8(): String {
    return;
  }

  fn quiet#9(text#10: String): Int32 {
    return int#97(text#10)^;
  }

  init {
    return;
  }
}
--- problems
F1 @5: falls#1 can reach its end without returning
F1 @18: breaks#5 can reach its end without returning
F2 @26: a Void function's return has no value
F2 @30: the return needs a String
F4 @35: the call of int#97 may bubble, but quiet#9 can't
F2 @38: a return outside a function

=== module init order (F5, R6)
tmpl 1 model 1 library init 0.1.0

module init#0 {
  fn log#99(s#96: String): Void {}

  fn str#98(n#95: Int32): String {
    return "n";
  }

  let a#1: Int32;

  let b#2: Int32;

  var c#3: Int32;

  fn f#4(): Void {
    b#2 = 1;
  }

  init {
    init a#1 = %Int32.add(b#2, 1);
    init b#2 = 2;
    init b#2 = 3;
    log#99(str#98(c#3));
    c#3 = 1;
  }
}
--- problems
R6 @13: b#2 isn't a var
F5 @18: b#2 may be read before it's initialized
R6 @22: b#2 isn't a var, but may be initialized twice
F5 @27: c#3 may be read before it's initialized

=== an initializer outside init (S3)
tmpl 1 model 1 library places 0.1.0

module places#0 {
  fn log#99(s#96: String): Void {}

  let a#1: Int32;

  fn f#2(): Void {
    init a#1 = 1;
    log#99(true);
  }

  init {}
}
--- problems
S3 @6: InitLet outside an init block

=== qnames and connected declarations (Q1, Q2, Q3, Q4)
tmpl 1 model 1 library q 0.1.0

uses `temper-core`#1 0.1.0 {
  connected("rust") fn hosted#2(): Void;
}

module q#0 {
  fn f#3(): Void {}

  qname "f()" let other#4: Int32;

  qname "f(" let broken#5: Int32;

  fn bare#6(): Void;

  connected("py") fn listed#7(): Void;

  connected fn fine#8(): Void;

  init {}
}
--- problems
Q4 #2: a connected declaration with backends needs a body
Q1 #4: its qname q.f() is also #3's
Q2 #5: its qname override doesn't parse: can't tell the kind of `f(` at offset 0 in `f(`
Q3 @4: bare#6 has no body, but isn't connected
Q4 @5: listed#7 lists backends, so it needs a body as their fallback

=== methods and omitted arguments (T3)
tmpl 1 model 1 library calls 0.1.0

uses `temper-core`#1 0.1.0 {
  class Int32#2 {
    connected method toString#3(radix?: Int32): String;
  }
  class String#4 {
    connected method toInt32#5(radix?: Int32): Int32 throws Bubble;
  }
}

module calls#0 {
  fn f#6(a#7: Int32, b#8?: Int32): String throws Bubble {
    let s#9: String = "1".toString#3(omitted);
    let n#10: Int32 = s#9.toInt32#5(omitted, omitted)^;
    let t#11: String = f#6(omitted, omitted)^;
    return a#7.toString#3("2");
  }

  init {}
}
--- problems
N2 @2: b#8 is optional, so it should be nullable
N2 @2: b#8's default should be the body's statement 1 after those before it
T3 @6: the receiver is String, but should be Int32
T3 @9: toInt32#5 takes 1 arguments, not 2
T1 @12: Omitted needs a type
T3 @15: argument 1 of f#6 can't be omitted
T3 @20: argument 1 is String, but should be Int32

=== a parameter that isn't var, assigned (R6)
tmpl 1 model 1 library params 0.1.0

module params#0 {
  fn f#1(i#2: Int32): Int32 {
    i#2 = 1;
    return i#2;
  }

  init {}
}
--- problems
R6 @3: i#2 isn't a var

=== imports and tests (M1, M2)
tmpl 1 model 1 library m 0.0.0

uses std#1 0.6.0 {
  module testing#2 {
    class Test#3 {}
  }
}

module early#4 in "early" {
  fn hidden#5(): Int32 {
    return late#7();
  }

  export var shared#6: Int32;

  init {
    init shared#6 = 1;
  }
}

module late#8 in "late" {
  export fn late#7(): Int32 {
    return %Int32.add(hidden#5(), shared#6);
  }

  init {
    shared#6 = 2;
  }

  test "wrong" ~test#9(n#10: Int32): Void {}
}
--- problems
M1 @3: late#7 is in a module that comes later, so can't be imported
M1 @12: hidden#5 isn't exported from its module
M1 @15: shared#6 is another module's
M2 @17: a test's signature is fn (Test): Void throws Bubble, with std's Test

=== switches (F7, R5)
tmpl 1 model 1 library switches 0.1.0

module switches#0 {
  fn f#1(n#2: Int32, b#3: Boolean): Int32 {
    var s#4: Int32;
    switch (n#2) {
      case 1, 2 {
        s#4 = 1;
      }
      case 2 {}
      case n#2, 3i64 {}
    }
    switch (b#3) {
      case 1 {}
    }
    switch (n#2) {
      default {}
      case 4 {}
    }
    return s#4;
  }

  init {}
}
--- problems
F7 @14: the label 2 is in another case too
F7 @17: a case's label isn't a literal Int32
F7 @18: a case's label isn't a literal Int32
F7 @21: a switch on Boolean, not Int32 or Int64
F7 @27: a default that isn't the last case
R5 @33: s#4 may be read before it's assigned
