// interactive/src/main/java/interactive/InteractiveGlobal.java
package interactive;

import temper.core.Core;

public final class InteractiveGlobal {
    private InteractiveGlobal() {}

    static {
        Object total;
        Point p = new Point(1, 2);
        Core.throwBubble();
    }
}
// interactive/src/main/java/interactive/Point.java
package interactive;

final class Point {
    public final int x;
    public final int y;

    public Point(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public int sum() {
        return this.x + this.y;
    }

    public int getX() {
        return this.x;
    }

    public int getY() {
        return this.y;
    }

    public static final class Builder {
        int x;
        boolean x__set;

        public Builder x(int x) {
            x__set = true;
            this.x = x;
            return this;
        }

        int y;
        boolean y__set;

        public Builder y(int y) {
            y__set = true;
            this.y = y;
            return this;
        }

        public Point build() {
            if (!x__set || !y__set) {
                StringBuilder _message = new StringBuilder("Missing required fields:");
                if (!x__set) {
                    _message.append(" x");
                }
                if (!y__set) {
                    _message.append(" y");
                }
                throw new IllegalStateException(_message.toString());
            }
            return new Point(x, y);
        }
    }
}
interactive#3: void
// interactive/init.hpp
#pragma once

#include <temper-core/core.hpp>

namespace interactive {

// Runs the module's top level, once. Exported functions, constructors,
// static functions, and accessors run it first, so calling it is
// optional.
void global_init_init();

struct Point;

struct Point : public std::enable_shared_from_this<Point> {
  int32_t x;
  int32_t y;
  static std::shared_ptr<Point> make(int32_t x, int32_t y);
  int32_t sum() const;
  int32_t get_x() const;
  int32_t get_y() const;
};

}  // namespace interactive
// interactive/init.cpp
#include <interactive/init.hpp>

namespace interactive {

namespace core = temper::core;

std::shared_ptr<Point> Point::make(int32_t x, int32_t y) {
  std::shared_ptr<Point> self = std::make_shared<Point>();
  self->x = x;
  self->y = y;
  return self;
}

int32_t Point::sum() const {
  return core::Int::add(this->x, this->y);
}

int32_t Point::get_x() const {
  return this->x;
}

int32_t Point::get_y() const {
  return this->y;
}

void global_init_init() {
  core::init_once([] {
    std::shared_ptr<core::AnyValueBase> total;
    std::shared_ptr<Point> p = Point::make(1, 2);
    core::bubble();
  });
}

}  // namespace interactive
interactive#4: void
// interactive/src/mod.rs
use std::sync::{Arc, OnceLock};

pub(crate) fn init() -> temper_core::Result<()> {
    static INIT_ONCE: OnceLock<temper_core::Result<()>> = OnceLock::new();
    INIT_ONCE
        .get_or_init(|| {
            let _p = Point::new(1, 2);
            Err(temper_core::Error::new())
        })
        .clone()
}

struct PointStruct {
    x: i32,
    y: i32,
}

#[derive(Clone)]
pub(crate) struct Point(Arc<PointStruct>);

impl Point {
    pub fn new(x: i32, y: i32) -> Point {
        Point(Arc::new(PointStruct { x, y }))
    }

    pub fn sum(&self) -> i32 {
        self.0.x.wrapping_add(self.0.y)
    }
}

temper_core::impl_any_value_trait!(Point, []);

static _TOTAL: OnceLock<temper_core::AnyValue> = OnceLock::new();

pub(crate) fn _total() -> temper_core::AnyValue {
    crate::support::initialized(|| _TOTAL.get()).clone()
}
