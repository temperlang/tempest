  q"""
    : for (let x of xs) {
    ~'${x}
    : }
}
let openedRt(xs: List<String>): String {
  do {
    let t = new Quoting();
    for (let x of xs) { t.appendSafe("'"); t.append(x); }
    let u = t;
    t.accumulated
  }
}
console.log("opened ${opened(["i", "j", "k"])} ${openedRt(["i", "j", "k"])}");
let skipped(n: Int, x: String): String {
  q"""
    : for (var i = 0; i < n; i++) {
    ~'${x}
    : if (i == 0) { continue; }
    ~'
    : }
    ~${x}
}
