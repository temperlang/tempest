// Each use below is left to run time, so it logs what the same calls do
// written out by hand with one more read of the accumulator, which no
// fold takes.

// Branches end in different states, which `mergeStates` reports, and a
// library error keeps a use from folding.
let mixed(c: Boolean, x: String): String {
  q"""
    : if (c) {
    ~'
    : }
    ~${x}
}
let mixedRt(c: Boolean, x: String): String {
  do {
    let t = new Quoting();
    if (c) { t.appendSafe("'"); }
    t.append(x);
    let u = t;
    t.accumulated
  }
}
console.log("mixed ${mixed(false, "e")} ${mixedRt(false, "e")}");

// A merge that keeps one branch's state silently: only branches ending in
// the same state fold.
class Silent extends ContextualAutoescapingAccumulator {
  public static newCollector(): Buffer { new Buffer() }
  public static initialState(): Boolean { false }
  public static propagator(): Propagator { new Propagator("'") }
  public static picker(): Picker { new Picker(false) }
  public static sameStatePredicate(): fn (Boolean, Boolean): Boolean {
    fn (a: Boolean, b: Boolean): Boolean { a == b }
  }
  public static mergeStates(a: Boolean, b: Boolean, callout: Callout): Boolean { a }
  public static checkEndState(inQuote: Boolean, callout: Callout): Void {}
  public static fromCollector(c: Buffer): String { c.toString() }
  public static enact(m: Mark, c: Buffer): Void { c.mark(m) }
  private var inQuote: Boolean = false;
  private collector: Buffer = new Buffer();
  public appendSafe(x: String): Void {
    let after = propagateOver(Silent.propagator(), inQuote, x, Silent.sameStatePredicate(), ignore);
    inQuote = after.stateAfter;
    for (let e of after.effects) { e.enactOn(collector); }
  }
  public append(x: String): Void {
    let escaped = Silent.picker().escaperFor(inQuote, ignore).apply(x);
    collector.append(escaped);
  }
  public get accumulated(): String { collector.toString() }
}
let silent = Silent;
let under(c: Boolean, x: String): String {
  silent"""
    : if (c) {
    ~a
    : } else {
    ~'
    : }
    ~${x}
}
let underRt(c: Boolean, x: String): String {
  do {
    let t = new Silent();
    if (c) { t.appendSafe("a"); } else { t.appendSafe("'"); }
    t.append(x);
    let u = t;
    t.accumulated
  }
}
console.log("under ${under(true, "f")} ${underRt(true, "f")}");

// An escaper with settings of its own isn't its class's `instance`.
class Wrap(public mark: String) extends Escaper {
  public static instance: Wrap = new Wrap("default");
  public applyString(x: String): String { "${mark}:${x}" }
}
class Picker2 {
  public escaperFor(inQuote: Boolean, callout: Callout): Escaper { new Wrap("quoted") }
}
class Wrapping extends ContextualAutoescapingAccumulator {
  public static newCollector(): Buffer { new Buffer() }
  public static initialState(): Boolean { false }
  public static propagator(): Propagator { new Propagator("'") }
  public static picker(): Picker2 { new Picker2() }
  public static sameStatePredicate(): fn (Boolean, Boolean): Boolean {
    fn (a: Boolean, b: Boolean): Boolean { a == b }
  }
  public static mergeStates(a: Boolean, b: Boolean, callout: Callout): Boolean { a }
  public static checkEndState(inQuote: Boolean, callout: Callout): Void {}
  public static fromCollector(c: Buffer): String { c.toString() }
  public static enact(m: Mark, c: Buffer): Void { c.mark(m) }
  private var inQuote: Boolean = false;
  private collector: Buffer = new Buffer();
  public appendSafe(x: String): Void {
    let after = propagateOver(Wrapping.propagator(), inQuote, x, Wrapping.sameStatePredicate(), ignore);
    inQuote = after.stateAfter;
    for (let e of after.effects) { e.enactOn(collector); }
  }
  @overload("append")
  public appendStr(x: String): Void {
