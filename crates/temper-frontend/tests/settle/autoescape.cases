// Each use below is logged beside the same calls written out by hand
// with one more read of the accumulator, which no fold takes, so it
// propagates at run time: the two agree.

// Loops whose passes end in the context they start in fold once; the
// state after them is the state before.
let listed(xs: List<String>): String {
  q"""
    ~(
    : for (let x of xs) {
    ~ '${x}' ${x}
    : }
    ~)
}
let listedRt(xs: List<String>): String {
  do {
    let t = new Quoting();
    t.appendSafe("(");
    for (let x of xs) { t.appendSafe(" '"); t.append(x); t.appendSafe("' "); t.append(x); }
    t.appendSafe(")");
    let u = t;
    t.accumulated
  }
}
console.log("for of ${listed(["a", "b"])} ${listedRt(["a", "b"])}");
// `break` and `continue` in the context the loop starts in.
let counted(n: Int, x: String): String {
  q"""
    : var i = 0;
    : while (i < n) {
    : i += 1;
    : if (i == 2) { continue; }
    ~'${x}'
    : if (i == 4) { break; }
    ~${x},
    : }
    ~.
}
let countedRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    var i = 0;
    while (i < n) {
      i += 1;
      if (i == 2) { continue; }
      t.appendSafe("'"); t.append(x); t.appendSafe("'");
      if (i == 4) { break; }
      t.append(x); t.appendSafe(",");
    }
    t.appendSafe(".");
    let u = t;
    t.accumulated
  }
}
console.log("while ${counted(5, "c")} ${countedRt(5, "c")}");
let stepped(n: Int, x: String): String {
  q"""
    : for (var i = 0; i < n; i++) {
    ~(${x})
    : }
    : var j = 0;
    : do {
    ~'${x}';
    : j += 1;
    : } while (j < n);
}
let steppedRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    for (var i = 0; i < n; i++) { t.appendSafe("("); t.append(x); t.appendSafe(")"); }
    var j = 0;
    do { t.appendSafe("'"); t.append(x); t.appendSafe("';"); j += 1; } while (j < n);
    let u = t;
    t.accumulated
  }
}
console.log("for, do ${stepped(2, "d")} ${steppedRt(2, "d")} ${stepped(0, "d")} ${steppedRt(0, "d")}");
// Nested loops, and labeled jumps, that agree. Logic lines don't take
// labels, so these blocks are written as tagged strings settle, which
// folds alike.
let grid(n: Int, x: String): String {
  do {
    let t = new Quoting();
    outer: for (var i = 0; i < n; i++) {
      for (var j = 0; j < n; j++) {
        if (j > i) { continue outer; }
        if (i == 2) { break outer; }
        t.appendSafe("'"); t.append(x); t.appendSafe("'"); t.append(j.toString());
      }
      t.appendSafe(";");
    }
    t.accumulated
  }
}
let gridRt(n: Int, x: String): String {
  do {
    let t = new Quoting();
    outer: for (var i = 0; i < n; i++) {
      for (var j = 0; j < n; j++) {
        if (j > i) { continue outer; }
        if (i == 2) { break outer; }
        t.appendSafe("'"); t.append(x); t.appendSafe("'"); t.append(j.toString());
      }
      t.appendSafe(";");
    }
    let u = t;
    t.accumulated
  }
}
console.log("nested ${grid(3, "e")} ${gridRt(3, "e")}");

// A path that leaves the tagged string, by `return`, `bubble()`, or a
// jump to a loop around it, never reads the accumulator again, so the
// state it leaves in joins nothing, even inside quotes.
let attribute(c: Boolean, x: String): String {
  q"""
    ~a='
    : if (c) { return "none"; }
    ~${x}'
}
let attributeRt(c: Boolean, x: String): String {
  do {
    let t = new Quoting();
    t.appendSafe("a='");
    if (c) { return "none"; }
    t.append(x);
    t.appendSafe("'");
    let u = t;
    t.accumulated
  }
}
console.log("return ${attribute(false, "f")} ${attributeRt(false, "f")} ${attribute(true, "f")} ${attributeRt(true, "f")}");
let bubbled(c: Boolean, x: String): String throws Bubble {
  q"""
    : if (c) {
    ~'
    : bubble();
    : }
    ~${x}
}
let bubbledRt(c: Boolean, x: String): String throws Bubble {
  do {
    let t = new Quoting();
    if (c) { t.appendSafe("'"); bubble(); }
    t.append(x);
    let u = t;
    t.accumulated
  }
}
console.log("bubble ${bubbled(false, "g") orelse "failed"} ${bubbledRt(false, "g") orelse "failed"} ${bubbled(true, "g") orelse "failed"}");
let around(n: Int, x: String): String {
  var r = "";
  for (var i = 0; i < n; i++) {
    let s = q"""
      ~'
      : if (i == 0) { continue; }
      : if (i == 2) { break; }
      ~${x}'
    ;
    r = "${r}${s}";
  }
  r
}
let aroundRt(n: Int, x: String): String {
  var r = "";
  for (var i = 0; i < n; i++) {
    let s = do {
      let t = new Quoting();
      t.appendSafe("'");
      if (i == 0) { continue; }
      if (i == 2) { break; }
      t.append(x);
      t.appendSafe("'");
      let u = t;
      t.accumulated
    };
    r = "${r}${s}";
  }
  r
}
console.log("around ${around(3, "h")} ${aroundRt(3, "h")}");

// Left to run time: a loop whose body changes the context, as by
// opening a quote, or a `continue` that skips closing one.
