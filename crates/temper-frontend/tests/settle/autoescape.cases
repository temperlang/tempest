// A labeled `continue` inside quotes.
let resumed(n: Int, x: String): String {
  do {
    let t = new Quoting();
    outer: for (var i = 0; i < n; i++) {
      for (var j = 0; j < n; j++) {
        t.appendSafe("'");
        if (j == 1) { continue outer; }
        t.append(x); t.appendSafe("'");
      }
    }
    t.append(x);
    t.accumulated
  }
}
