=== a bubbling path
class Ok {
  public a: Int;
  public constructor(x: Int): Void throws Bubble {
    if (x < 0) {
      bubble();
    }
    if (x > 9) {
      panic();
    } else {
      this.a = x;
    }
    console.log(this.text());
  }
  public text(): String { a.toString() }
}
class Bad {
  public a: Int;
  public constructor(x: Int): Void throws Bubble {
    this.a = (x / 2) orelse this.text().size;
  }
  public text(): String { "" }
}
console.log(new Ok(5).a.toString());
