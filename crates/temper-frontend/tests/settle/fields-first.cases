=== a closure capturing this
@fun interface Thunk(): Int;
class Ok {
  public a: Int;
  public f: Thunk;
  public constructor() { this.a = 1; let g: Thunk = fn (): Int { 2 }; this.f = g; }
}
class Bad {
  public a: Int;
  public f: Thunk;
  public constructor() { this.f = fn (): Int { a }; this.a = 1; }
}
console.log(new Ok().f().toString());
--- settled
