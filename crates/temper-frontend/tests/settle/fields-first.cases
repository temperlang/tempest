=== every path sets every field
class Ok {
  public a: Int;
  public constructor(x: Int) {
    if (x > 0) {
      this.a = 1;
      return;
    }
    this.a = 2;
  }
}
class Bad {
  public a: Int;
  public b: Int;
  public constructor(x: Int) {
    this.a = 1;
    if (x > 0) {
      this.b = 1;
      return;
    }
  }
}
class NoConstructor {
  public a: Int;
  public b: Int = 1;
}
new Ok(1);
