=== a method call
class Ok {
  public a: Int;
  public constructor() { a = 1; check(); }
  public check(): Void { console.log("checked ${a}"); }
}
class Bad {
  public a: Int;
  public constructor() { check(); a = 1; }
  public check(): Void {}
}
new Ok();
