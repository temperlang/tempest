=== loops
class Ok {
  public a: Int;
  public constructor(xs: List<Int>) {
    var i = 0;
    while (true) { this.a = xs[i] orelse 0; break; }
    console.log(this.twice().toString());
  }
  public twice(): Int { a * 2 }
}
class Bad {
  public a: Int;
  public constructor(xs: List<Int>) {
    for (let x of xs) { this.a = x; }
    console.log(this.twice().toString());
  }
  public twice(): Int { a * 2 }
}
new Ok([3]);
