=== passing this along
let show(o: Ok): Void { console.log(o.a.toString()); }
class Ok {
  public a: Int;
  public constructor() { this.a = 4; show(this); }
}
class Bad {
  public a: Int;
  public b: Bad?;
  public constructor() { let me = this; this.b = null; this.a = 1; }
}
new Ok();
