# Fields first (notes/typing.md): a constructor, and the field
# initializers before it, use `this` only to set fields and read those
# already set until every field is set on every path. Kotlin Temper
# reports only "Property x not initialized in constructor", for a class
# without a constructor; it accepts the failing cases here.
=== straight-line code
class Ok {
  public a: Int;
  public b: Int;
  public constructor(x: Int) { this.a = x; b = x + 1; console.log(this.sum().toString()); }
  public sum(): Int { a + b }
}
class Bad {
  public a: Int;
  public b: Int;
  public constructor(x: Int) { this.a = x; let s = this.sum(); this.b = s + 1; }
  public sum(): Int { a }
}
new Ok(1);
--- settled
(Block
  (Class
    ^Ok:0
    (Let ^a:3 Int)
    (Let ^b:4 Int)
    (Constructor
      ^constructor:5
      (Fn
        (Let ^x:7 Int)
        (Block
          (Assign (Call . this#2 \a) x:7)
          (Assign b:4 (Call + x:7 1))
          (Call
            (Call . console \log)
            (Call (Call . (Call (Call . this#2 \sum)) \toString)))
          #void)))
    (Method ^sum:6 (Fn Int (Block (Call + a:3 b:4)))))
  (Class
    ^Bad:1
    (Let ^a:9 Int)
    (Let ^b:10 Int)
    (Constructor
      ^constructor:11
      (Fn
        (Let ^x:13 Int)
        (Block
          (Assign (Call . this#8 \a) x:13)
          (Let ^s:14 (Call (Call . this#8 \sum)))
          (Assign (Call . this#8 \b) (Call + s:14 1))
          #void)))
    (Method ^sum:12 (Fn Int (Block a:9))))
  (Call new Ok:0 1)
  #void)
error 266..274: Calling this.sum() before b is set
log 3

=== branches
class Ok {
  public a: Int;
  public constructor(x: Int) {
    if (x > 0) {
      this.a = x;
    } else {
      this.a = 0;
    }
    show();
  }
  public show(): Void { console.log(a.toString()); }
}
class Bad {
  public a: Int;
  public constructor(x: Int) {
    if (x > 0) {
      this.a = x;
    }
    show();
    this.a = 0;
  }
  public show(): Void { console.log(a.toString()); }
}
new Ok(2);
