=== reading a field that's already set
class Ok {
  public a: Int;
  public var b: Int;
  public c: Int = 3;
  public d: Int = c + 1;
  public constructor() { this.a = c; b = this.a + d; this.b += 1; }
}
let o = new Ok();
console.log("${o.a} ${o.b}");
