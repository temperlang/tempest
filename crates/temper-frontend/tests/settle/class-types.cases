# Classes' types: values of classes and interfaces, their members read,
# called and assigned, constructors, and the type errors Kotlin Temper
# reports for them, with its messages, though classes are named as
# written (Kotlin says `C__0`). Input, then the settled tree and
# diagnostics as print::write_settled writes them, then what running it
# logs; type errors don't stop a run.
=== values of classes and interfaces
interface I { public f(): Int; }
interface J {}
class C(public x: Int) {
  public me(): C { this }
  public bad(): String { this }
}
class D extends I { public f(): Int { 1 } }
let i: I = new D();
let j: I = new C(1);
let k: C = new D();
let l: String = new C(1);
let m: C = "s";
let n: C = null;
let take(x: I): Void {}
take(new C(2));
take(new D());
let q: J = i;
let p: D = i;
--- settled
(Block
  (Interface ^I:0 (Method ^f:14 Int))
  (Interface ^J:1)
  (Class
    ^C:2
    (Param ^x:17 Int)
    (Method ^me:18 (Fn C:2 (Block this#16)))
    (Method ^bad:19 (Fn String (Block this#16))))
  (Class ^D:3 I:0 (Method ^f:21 (Fn Int (Block 1))))
  (Let ^i:4 I:0 (Call new D:3))
  (Let ^j:5 I:0 (Call new C:2 1))
  (Let ^k:6 C:2 (Call new D:3))
  (Let ^l:7 String (Call new C:2 1))
  (Let ^m:8 C:2 "s")
  (Let ^n:9 C:2 null)
  (Let ^take:10 (Fn (Let ^x:22 I:0) Void (Block)))
  (Call take:10 (Call new C:2 2))
  (Call take:10 (Call new D:3))
  (Let ^q:11 J:1 i:4)
  (Let ^p:12 D:3 i:4)
  #void)
error 124..128: Cannot assign to String from C
error 208..216: Cannot assign to I from C
error 229..236: Cannot assign to C from D
error 254..262: Cannot assign to String from C
error 275..278: Cannot assign to C from String
error 291..295: Expected subtype of C, but got C?
error 326..334: Expected subtype of I, but got C

=== members read, called and assigned
class C(public x: Int, public var s: String) {
  public get twice(): Int { x * 2 }
  public add(n: Int, m: Int = 2): Int { x + n + m }
  public static make(): C { new C(1, "a") }
  public go(): String { add("a") }
  public go2(): String { this.add(1) }
  public go3(): Int { add(1, 2, 3) }
  public assign(): Void { this.s = 4; s = 5; }
}
let c = new C(1, "a");
let a: String = c.x;
let b: Int = c.s;
let t: String = c.twice;
let r: String = c.add(1);
c.add("q");
c.add(1, "m");
c.s = 3;
let mk: String = C.make();
let wrong(): Void { c.add(); }
--- settled
(Block
  (Class
    ^C:0
    (Param ^x:9 Int)
    (Param var ^s:10 String)
    (Get ^twice:11 (Fn Int (Block (Call * x:9 2))))
    (Method
      ^add:12
      (Fn
        (Let ^n:18 Int)
        (Let ^m:19 Int 2)
        Int
        (Block (Call + (Call + x:9 n:18) m:19))))
    (Method static ^make:13 (Fn C:0 (Block (Call new C:0 1 "a"))))
    (Method ^go:14 (Fn String (Block (Call add:12 "a"))))
    (Method ^go2:15 (Fn String (Block (Call (Call . this#8 \add) 1))))
    (Method ^go3:16 (Fn Int (Block (Call add:12 1 2 3))))
    (Method
      ^assign:17
      (Fn Void (Block (Assign (Call . this#8 \s) 4) (Assign s:10 5) #void))))
  (Let ^c:1 (Call new C:0 1 "a"))
  (Let ^a:2 String (Call . c:1 \x))
  (Let ^b:3 Int (Call . c:1 \s))
  (Let ^t:4 String (Call . c:1 \twice))
  (Let ^r:5 String (Call (Call . c:1 \add) 1))
  (Call (Call . c:1 \add) "q")
  (Call (Call . c:1 \add) 1 "m")
  (Assign (Call . c:1 \s) 3)
  (Let ^mk:6 String (Call (Call . C:0 \make)))
  (Let ^wrong:7 (Fn Void (Block (Call (Call . c:1 \add)) #void))))
