=== members read, called and assigned
class C(public x: Int, public var s: String) {
  public get twice(): Int { x * 2 }
  public add(n: Int, m: Int = 2): Int { x + n + m }
  public static make(): C { new C(1, "a") }
  public go(): String { add("a") }
  public go2(): String { this.add(1) }
  public go3(): Int { add(1, 2, 3) }
  public assign(): Void { this.s = 4; s = 5; }
}
let c = new C(1, "a");
let a: String = c.x;
let b: Int = c.s;
let t: String = c.twice;
let r: String = c.add(1);
c.add("q");
c.add(1, "m");
c.s = 3;
let mk: String = C.make();
let wrong(): Void { c.add(); }
