=== is and as checks of type parameters' values and generic types
// A type parameter's value is checked as its bound's, all that's known of
// it at run time, so `x is Dog` for `T extends Animal` is a downcast,
// where Kotlin Temper says the types are unrelated; and a check can't
// introduce a type argument, which erasure leaves no way to check. Kotlin
// leaves alone parameters marked `@out` or `@in`, as `Out`'s.
interface Animal {}
class Dog extends Animal {}
class Cat {}
class Box<T> {}
class Out<@out T> {}
let a1<T extends Animal>(x: T): Boolean { x is Dog }
let a2<T>(x: T): Boolean { x is Dog }
let a3<T>(x: T): Boolean { x is Int }
let a4<T extends Animal>(x: T): Boolean { x is Cat }
let a5<T extends Animal>(x: T): Boolean { x is Animal }
let a6<T extends Animal>(x: T?): Boolean { x is Dog }
let a7<T extends Animal>(x: T): Dog { x as Dog }
let a8<T>(x: T): Boolean { x is T }
let b1(x: AnyValue): Boolean { x is List<Int> }
let b2(x: AnyValue): Boolean { x is Box<Int> }
let b3(x: AnyValue): Boolean { x is Box<String>? }
let b4<T>(x: Box<T>): Boolean { x is Box<T> }
let b5<T>(x: AnyValue): Boolean { x is Box<T> }
let b6(x: Listed<Int>): Boolean { x is List<Int> }
let b7(x: AnyValue): Box<Int> throws Bubble { x as Box<Int> }
let b8(x: AnyValue): Boolean { x is Out<Int> }
let b9(x: AnyValue): Out<Int> { x as Out<Int> }
let c1(x: Box<Int>): Boolean { x is Box<String> }
let c2(x: String): Boolean { x is Box<String> }
let c3(k: MapKey<Int>): Boolean { k is Int }
let c4(k: MapKey<Int>): Boolean { k is String }
let pet<T extends Animal>(x: T): String { if (x is Dog) { "dog" } else { "other" } }
console.log(pet(new Dog()));
