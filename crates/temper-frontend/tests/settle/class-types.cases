=== constructors and field initializers
class E {
  public k: Int = "k";
  public var m: String = 1;
  public static st: Int = 2;
}
class P {
  public var n: Int = 0;
  public constructor(n: Int, extra: String = "e") { this.n = n; }
}
class Q(public x: Int, public y: String = "y") {}
let st: String = E.st;
let make(): Void {
  new P(1, 2);
  new P();
  new Q("1", 2);
  new Q(1, "y", 3);
}
--- settled
(Block
  (Class ^E:0 (Let ^k:6 Int "k") (Var ^m:7 String 1) (Let static ^st:8 Int 2))
  (Class
    ^P:1
    (Var ^n:10 Int 0)
    (Constructor
      ^constructor:11
      (Fn
        (Let ^n:12 Int)
        (Let ^extra:13 String "e")
        (Block (Assign (Call . this#9 \n) n:12) #void))))
  (Class ^Q:2 (Param ^x:15 Int) (Param ^y:16 String "y"))
  (Let ^st:3 String (Call . E:0 \st))
  (Let
    ^make:4
    (Fn
      Void
      (Block
        (Call new P:1 1 2)
        (Call new P:1)
        (Call new Q:2 "1" 2)
        (Call new Q:2 1 "y" 3)
        #void))))
