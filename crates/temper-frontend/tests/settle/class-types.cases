=== methods inherited more than once
interface A { public a(x: Int): Int { 1 } }
interface B { public a(x: Int): Int { 2 } }
interface A1 { public a(): Void {} }
interface B1 extends A1 {}
interface C1 { public a(): String { "C1" } }
interface C2 { public a(): Void { } }
class T extends A & B {}
class U extends B1 & C1 {}
class V extends B1 & C2 {}
interface W extends A & B {}
let t: String = new T().a(1);
new U().a();
let take(w: W): Void { let s: String = w.a(1); }
console.log(new T().a(1).toString());
new V().a();
--- settled
(Block
  (Interface ^A:0 (Method ^a:13 (Fn (Let ^x:14 Int) Int (Block 1))))
