=== members of interfaces, and methods that bubble
interface Shape {
  public area(): Float64;
  public get name(): String { "shape" }
  public scaled(k: Float64): Float64 { area() * k }
}
let s1(s: Shape): Int { s.area() }
let s2(s: Shape): Int { s.name }
let s3(s: Shape): Float64 { s.scaled("x") }
class P(public x: Int) {
  public risky(): Int throws Bubble { if (x == 0) { bubble() } else { x } }
  public bad(): Int { risky() }
  public safe(): Int { risky() orelse 0 }
}
let g(p: P): Int { p.risky() }
--- settled
(Block
  (Interface
    ^Shape:0
    (Method ^area:7 (Signature Float64))
    (Get ^name:8 (Fn String (Block "shape")))
    (Method
      ^scaled:9
      (Fn (Let ^k:10 Float64) Float64 (Block (Call * (Call area:7) k:10)))))
  (Let ^s1:1 (Fn (Let ^s:11 Shape:0) Int (Block (Call (Call . s:11 \area)))))
  (Let ^s2:2 (Fn (Let ^s:12 Shape:0) Int (Block (Call . s:12 \name))))
  (Let
    ^s3:3
    (Fn (Let ^s:13 Shape:0) Float64 (Block (Call (Call . s:13 \scaled) "x"))))
  (Class
    ^P:4
    (Param ^x:15 Int)
    (Method
      ^risky:16
      (Fn
        (Call throws Int Bubble)
        (Block (If (Call == x:15 0) (Block (Fail)) (Block x:15)))))
    (Method ^bad:17 (Fn Int (Block (Call risky:16))))
    (Method ^safe:18 (Fn Int (Block (Orelse (Call risky:16) 0)))))
  (Let ^g:5 (Fn (Let ^p:19 P:4) Int (Block (Call (Call . p:19 \risky))))))
