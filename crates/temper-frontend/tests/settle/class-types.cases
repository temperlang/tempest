=== operators defined by methods
interface I {}
class H(public name: String) {
  @operator("==")
  public eq(other: H): Boolean { name == other.name }
}
class G(public name: String) {
  @operator("==")
  public eq(other: G): Boolean { true }
}
class K {}
class C(public n: Int) {
  @operator("<=>")
  public compareTo(other: C): Int { n - other.n }
}
class D extends I {
  @operator("==")
  public eq(other: D): Boolean { true }
}
@auto("==") class P(public x: Int) {}
let a1(h: H, g: G): Boolean { h == g }
let a2(h: H): Boolean { h != "x" }
let a3(k: K): Boolean { k == k }
let a4(h: H, x: Int): Boolean { x == h }
let a5(h: H?, g: H): Boolean { h == g || g == h || g == null }
let a6(c: C, m: C?): Boolean { c < 1 || c < m || c >= null || 1 < c }
let a7(h: H): Boolean { h < h }
let a8(c: C): Int { c <=> "a" }
let a9(i: I, d: D): Boolean { if (i is D) { i == d } else { i == i } }
let b1(p: P): Boolean { p == 1 }
console.log("${new H("a") == new H("a")} ${new H("a") != new H("a")} ${new H("a") == new H("b")}");
console.log("${new C(1) < new C(2)} ${new C(1) >= new C(2)} ${(new C(3) <=> new C(2)).toString()}");
console.log("${new K() == new K()} ${new P(1) == new P(1)}");
--- settled
