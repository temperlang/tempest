error 446..455: Cannot bubble from a function without Bubble in its return type

=== a function in a field, called as a method
class Holder {
  public f: fn (Int): Int = fn (n: Int): Int { n * 2 };
}
let h = new Holder();
let hv: String = h.f(3);
console.log(h.f(4).toString());
--- settled
(Block
  (Class
    ^Holder:0
    (Let
      ^f:4
      (Call FnType Int Int)
      (Fn (Let ^n:5 Int) Int (Block (Call * n:5 2)))))
  (Let ^h:1 (Call new Holder:0))
  (Let ^hv:2 String (Call (Call . h:1 \f) 3))
  (Call
    (Call . console \log)
    (Call (Call . (Call (Call . h:1 \f) 4) \toString)))
  #void)
error 112..118: Cannot assign to String from Int32
log 8

=== methods inherited more than once
interface A { public a(x: Int): Int { 1 } }
interface B { public a(x: Int): Int { 2 } }
interface A1 { public a(): Void {} }
interface B1 extends A1 {}
interface C1 { public a(): String { "C1" } }
interface C2 { public a(): Void { } }
class T extends A & B {}
class U extends B1 & C1 {}
class V extends B1 & C2 {}
interface W extends A & B {}
let t: String = new T().a(1);
new U().a();
let take(w: W): Void { let s: String = w.a(1); }
console.log(new T().a(1).toString());
new V().a();
--- settled
(Block
  (Interface ^A:0 (Method ^a:13 (Fn (Let ^x:14 Int) Int (Block 1))))
  (Interface ^B:1 (Method ^a:16 (Fn (Let ^x:17 Int) Int (Block 2))))
  (Interface ^A1:2 (Method ^a:19 (Fn Void (Block))))
  (Interface ^B1:3 A1:2)
  (Interface ^C1:4 (Method ^a:23 (Fn String (Block "C1"))))
  (Interface ^C2:5 (Method ^a:25 (Fn Void (Block))))
  (Class ^T:6 A:0 B:1)
  (Class ^U:7 B1:3 C1:4)
  (Class ^V:8 B1:3 C2:5)
  (Interface ^W:9 A:0 B:1)
  (Let ^t:10 String (Call (Call . (Call new T:6) \a) 1))
  (Call (Call . (Call new U:7) \a))
  (Let
    ^take:11
    (Fn
      (Let ^w:34 W:9)
      Void
      (Block (Let ^s:35 String (Call (Call . w:34 \a) 1)) #void)))
  (Call
    (Call . console \log)
    (Call (Call . (Call (Call . (Call new T:6) \a) 1) \toString)))
  (Call (Call . (Call new V:8) \a))
  #void)
