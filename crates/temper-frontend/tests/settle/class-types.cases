=== abstract and functional interfaces' members, called and assigned
interface I {
  f(x: Int, y: String = ""): Int;
  get p(): Int;
  set p(v: Int): Void;
  g(): Int throws Bubble;
  @operator("==") eq(other: I): Boolean;
}
interface D extends I {}
class H(public n: Int) {}
let use(i: I, d: D, h: H): Int {
  i.f("a");
  i.f(1, 2);
  i.f();
  i.p = "s";
  let s: String = i.f(1);
  let b = d == h;
  i.g()
}
interface F(x: Int): String;
let callF(f: F): String { f.apply("x") }
