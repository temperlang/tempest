  (Let
    ^a1:7
    (Fn (Let ^h:36 H:1) (Let ^g:37 G:2) Boolean (Block (Call == h:36 g:37))))
  (Let ^a2:8 (Fn (Let ^h:38 H:1) Boolean (Block (Call != h:38 "x"))))
  (Let ^a3:9 (Fn (Let ^k:39 K:3) Boolean (Block (Call == k:39 k:39))))
  (Let
