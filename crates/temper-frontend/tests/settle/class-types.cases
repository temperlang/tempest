=== class values as builtin operators' operands
interface I {}
class C {}
class H {
  @operator("<=>")
  public compareTo(other: H): Int { 0 }
}
let a1(c: C): Int { c + 1 }
let a2(i: I): Int { 1 - i }
let a3(c: C): Int { -c }
let a4(c: C, i: I): Int { c * i }
let a5(c: C): Boolean { !c }
let a6(i: I): Int { i << 1 }
let a7(c: C): Float64 { c ** 2.0 }
let a8(c: C?): Int { c + 1 }
let a9(c: C?): Boolean { 1 < c }
let b1(h: H?, g: H): Boolean { h < g }
let b2(c: C?, d: C): Boolean { c < d }
