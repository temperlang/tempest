=== constructors and field initializers
class E {
  public k: Int = "k";
  public var m: String = 1;
  public static st: Int = 2;
}
class P {
  public var n: Int = 0;
  public constructor(n: Int, extra: String = "e") { this.n = n; }
}
class Q(public x: Int, public y: String = "y") {}
let st: String = E.st;
let make(): Void {
  new P(1, 2);
  new P();
  new Q("1", 2);
  new Q(1, "y", 3);
}
