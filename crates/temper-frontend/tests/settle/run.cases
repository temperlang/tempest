  (Call
    (Call . console \log)
    (Call cat (Call <=> "a" "b") " " (Call <=> "b" "b") " " (Call <=> 2 1)))
  (Let
    ^sorted:1
    (Call
      (Call . (Call list 3 1 2 1) \sorted)
