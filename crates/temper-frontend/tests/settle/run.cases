=== auto equality calls each field's own ==
class Loose(public n: Int) {
  @operator("==") public eq(other: Loose): Boolean { n % 10 == other.n % 10 }
}
@auto("==") class Tagged(public loose: Loose, public tag: String) {}
@auto("==") class Nested(public inner: Tagged) {}
let x = new Tagged(new Loose(3), "a");
let y = new Tagged(new Loose(13), "a");
let z = new Tagged(new Loose(4), "a");
console.log("${x == y} ${x == z} ${x != y} ${new Nested(x) == new Nested(y)}");
