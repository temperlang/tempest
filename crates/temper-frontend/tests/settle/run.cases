=== when, as Kotlin lowers it: if chains on a temporary
let name(x: Int): String {
  when (x * 1) {
    0 -> "zero";
    1, 2 -> "small";
    else -> "lots";
  }
}
class A {}
let kind(x: AnyValue): String { when (x) { is A -> "A"; is Int -> "Int"; else -> "?" } }
let nothing(x: Int): Void { when (x) { 0 -> console.log("zero"); } }
nothing(1);
console.log("${name(0)} ${name(2)} ${name(9)} ${kind(new A())} ${kind(1)} ${kind("s")}");
--- settled
(Block
  (Let
    ^name:0
    (Fn
      (Let ^x:4 Int)
      String
      (Block
        (Block
          (Let ^subject#5 (Call * x:4 1))
          (If
            (Call == subject#5 0)
            "zero"
            (If
              (If (Call == subject#5 1) #true (Call == subject#5 2))
              "small"
              "lots"))))))
  (Class ^A:1)
  (Let
    ^kind:2
    (Fn
      (Let ^x:7 AnyValue)
      String
      (Block
        (Block (If (Call is x:7 A:1) "A" (If (Call is x:7 Int) "Int" "?"))))))
  (Let
    ^nothing:3
    (Fn
      (Let ^x:8 Int)
      Void
      (Block
        (Block (If (Call == x:8 0) (Call (Call . console \log) "zero") (Block))))))
  (Call nothing:3 1)
  (Call
    (Call . console \log)
    (Call
      cat
      (Call name:0 0)
      " "
      (Call name:0 2)
      " "
      (Call name:0 9)
      " "
      (Call kind:2 (Call new A:1))
      " "
      (Call kind:2 1)
      " "
      (Call kind:2 "s")))
  #void)
