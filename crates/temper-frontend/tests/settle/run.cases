=== strings and string indices, as Kotlin Temper's
let s = "aé𐆊b";
let i1 = s.next(String.begin);
let i2 = s.next(i1);
let e = s.end;
console.log("${s.countBetween(String.begin, e)} ${s.countBetween(e, String.begin)} ${s.slice(i1, s.prev(e))} ${s[i2].toString(16)}");
console.log("${s.hasAtLeast(String.begin, e, 4)} ${s.hasAtLeast(String.begin, e, 5)} ${s.hasAtLeast(e, String.begin, 0)}");
console.log("${s.slice(s.step(e, -100), s.step(String.begin, 100))} ${s.next(e) == e} ${s.prev(String.begin) == String.begin} ${s.hasIndex(e)}");
console.log("${s.indexOf("b") is StringIndex} ${s.indexOf("x") is NoStringIndex} ${s.indexOf("", e) == e} ${StringIndex.none < String.begin}");
