=== Float64 formatting, order and methods, as Kotlin Temper's
let xs = [0.0, -0.0, 1.0, 1e7, 1234567.0, 9.99e-4, 1e23, 5e-324, 0.30000000000000004, NaN, -Infinity];
console.log(xs.join(" ") { x => x.toString() });
console.log("${-0.0 < 0.0} ${-0.0 == 0.0} ${NaN == NaN} ${NaN > Infinity} ${(1.0 / 0.0) orelse -1.0}");
console.log("${2.5.round()} ${(-0.0).sign()} ${NaN.max(1.0)} ${2.0 ** 0.5} ${3e9.toInt32() orelse -1} ${-4.9.toInt32Unsafe()}");
console.log("${"5e-1".toFloat64()} ${"2." .toFloat64() orelse -1.0} ${1.0.near(1.1)} ${1.0.near(1.1, null, 0.2)} ${Float64.pi}");
