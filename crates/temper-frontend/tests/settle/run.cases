=== static members, member operators and field assignment
interface A { a(): String { "A" } }
interface B extends A {}
interface C extends A { a(): String { "C" } }
class D extends B & C {
  public static var count = 0;
  public static make(): D { count += 1; new D(0) }
  public var n: Int;
  public fixed: Int;
  public constructor(n: Int) { this.n = n; fixed = n; }
  public bad(): Void { fixed = 2; }
}
let d = D.make();
d.n += 2;
console.log("${d.a()} ${d.n++} ${d.n} ${D.count}");
d.bad();
console.log("fixed is still ${d.fixed}");
--- settled
(Block
  (Interface ^A:0 (Method ^a:6 (Fn String (Block "A"))))
  (Interface ^B:1 A:0)
  (Interface ^C:2 A:0 (Method ^a:9 (Fn String (Block "C"))))
  (Class
    ^D:3
    B:1
    C:2
    (Var static ^count:11 0)
    (Method static
      ^make:12
      (Fn D:3 (Block (Assign count:11 (Call + count:11 1)) (Call new D:3 0))))
    (Var ^n:13 Int)
    (Let ^fixed:14 Int)
    (Constructor
      ^constructor:15
      (Fn
        (Let ^n:17 Int)
        (Block (Assign (Call . this#10 \n) n:17) (Assign fixed:14 n:17) #void)))
    (Method ^bad:16 (Fn Void (Block 2 #void))))
  (Let ^d:4 (Call (Call . D:3 \make)))
  (Block (Let ^o#18 d:4) (Assign (Call . o#18 \n) (Call + (Call . o#18 \n) 2)))
  (Call
    (Call . console \log)
    (Call
      cat
      (Call (Call . d:4 \a))
      " "
      (Block
        (Let ^o#19 d:4)
        (Let ^t#20 (Call . o#19 \n))
        (Assign (Call . o#19 \n) (Call + t#20 1))
        t#20)
      " "
      (Call . d:4 \n)
      " "
      (Call . D:3 \count)))
  (Call (Call . d:4 \bad))
  (Call (Call . console \log) (Call cat "fixed is still " (Call . d:4 \fixed)))
  #void)
