=== yield in nested orelse
let make(body: fn (Int, Int): Generator<Boolean>): Generator<Boolean> { body(6, 2) }
let g = make { (x: Int, y: Int): GeneratorResult<Boolean> throws Bubble extends GeneratorFn =>
  do {
    console.log("x / (y + 1) = ${x / (y + 1)}");
    do {
      console.log("x / (y - 2) = ${x / (y - 2)}");
      yield true;
    } orelse do {
      console.log("cannot divide by ${y - 2}");
      yield false;
    }
    console.log("after");
    x / (y - 2);
  } orelse do {
    console.log("outer orelse");
  }
};
console.log("made");
let r1 = g.next();
console.log("r1 ${r1 is ValueResult<Boolean>} done ${g.done}");
let r2 = g.next();
console.log("r2 ${r2 is ValueResult<Boolean>} done ${g.done}");
