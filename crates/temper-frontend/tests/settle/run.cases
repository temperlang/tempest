=== continue in a yielding loop, then done results
let make(body: fn (Int): SafeGenerator<Int>): SafeGenerator<Int> { body(3) }
let show(r: GeneratorResult<Int>): String {
  when (r) {
    is ValueResult<Int> -> "value ${r.value}";
    else -> "done";
  }
}
let it = make { (n: Int): GeneratorResult<Int> extends GeneratorFn =>
  for (var i = 0; i < n; i += 1) {
    if (i == 1) { continue; }
    yield i;
  }
};
console.log("${it is SafeGenerator<Int>} ${it.done}");
console.log(show(it.nextSafe()));
console.log(show(it.next()));
console.log("${it.done}");
console.log(show(it.nextSafe()));
console.log("${it.done}");
console.log(show(it.nextSafe()));
