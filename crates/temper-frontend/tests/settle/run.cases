# Running settled code: input, then the settled tree and diagnostics as
# print::write_settled writes them, then what running it logs.
=== Int wraps
let big = 0x7fff_ffff;
console.log((big + 1).toString());
console.log((-2147483648 / -1).toString());
console.log((-5 % 3).toString());
--- settled
(Block
  (Let ^big:0 2147483647)
  (Call (Call . console \log) (Call (Call . (Call + big:0 1) \toString)))
  (Call
    (Call . console \log)
    (Call (Call . (Call / (Call - -2147483648) (Call - 1)) \toString)))
  (Call (Call . console \log) (Call (Call . (Call % (Call - 5) 3) \toString)))
  #void)
warn 72..82: Int32 value, 2147483648, out of representable bounds
info 72..82: You can turn an Int32 literal into an Int64 by putting i64 at the end
log -2147483648
log -2147483648
log -2

