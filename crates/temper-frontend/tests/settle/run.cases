=== closures made in a generator's loop, each pass its own as in a function
let plain(): String {
  let fs = new ListBuilder<fn (): Int>();
  for (var i = 0; i < 3; i += 1) {
    let j = i * 10;
    fs.add(fn (): Int { j });
  }
  fs.toList().map { (f): String => "${f()}" }.join(" ") { it => it }
}
console.log("plain ${plain()}");
let drive(steps: Int, body: fn (): SafeGenerator<Empty>): Void {
  let g = body();
  for (var k = 0; k < steps; k += 1) { g.nextSafe(); }
}
drive(4) { (): GeneratorResult<Empty> extends GeneratorFn =>
  let fs = new ListBuilder<fn (): Int>();
  for (var i = 0; i < 3; i += 1) {
    let j = i * 10;
    fs.add(fn (): Int { j });
    yield();
  }
  console.log("yield in loop ${fs.toList().map { (f): String => "${f()}" }.join(" ") { it => it }}");
  yield();
}
drive(2) { (): GeneratorResult<Empty> extends GeneratorFn =>
  let fs = new ListBuilder<fn (): Int>();
  for (var i = 0; i < 3; i += 1) {
    let j = i * 10;
    fs.add(fn (): Int { j });
  }
  yield();
  console.log("yield after loop ${fs.toList().map { (f): String => "${f()}" }.join(" ") { it => it }}");
  yield();
}
drive(4) { (): GeneratorResult<Empty> extends GeneratorFn =>
  let fs = new ListBuilder<fn (): Int>();
  for (var i = 0; i < 3; i += 1) {
