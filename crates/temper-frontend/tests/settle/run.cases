=== static members, member operators and field assignment
interface A { a(): String { "A" } }
interface B extends A {}
interface C extends A { a(): String { "C" } }
class D extends B & C {
  public static var count = 0;
  public static make(): D { count += 1; new D(0) }
  public var n: Int;
  public fixed: Int;
  public constructor(n: Int) { this.n = n; fixed = n; }
  public bad(): Void { fixed = 2; }
}
let d = D.make();
d.n += 2;
console.log("${d.a()} ${d.n++} ${d.n} ${D.count}");
d.bad();
console.log("fixed is still ${d.fixed}");
--- settled
(Block
  (Interface ^A:0 (Method ^a:6 (Fn String (Block "A"))))
  (Interface ^B:1 A:0)
  (Interface ^C:2 A:0 (Method ^a:10 (Fn String (Block "C"))))
  (Class
    ^D:3
    B:1
    C:2
    (Var static ^count:12 0)
    (Method static
      ^make:13
      (Fn D:3 (Block (Assign count:12 (Call + count:12 1)) (Call new D:3 0))))
    (Var ^n:14 Int)
    (Let ^fixed:15 Int)
    (Constructor
      ^constructor:16
      (Fn
        (Let ^n:19 Int)
        (Block (Assign (Call . this#11 \n) n:19) (Assign fixed:15 n:19) #void)))
    (Method ^bad:17 (Fn Void (Block 2 #void))))
  (Let ^d:4 (Call (Call . D:3 \make)))
  (Block (Let ^o#20 d:4) (Assign (Call . o#20 \n) (Call + (Call . o#20 \n) 2)))
  (Call
    (Call . console \log)
    (Call
      cat
      (Call (Call . d:4 \a))
      " "
      (Block
        (Let ^o#21 d:4)
        (Let ^t#22 (Call . o#21 \n))
        (Assign (Call . o#21 \n) (Call + t#22 1))
        t#22)
      " "
      (Call . d:4 \n)
      " "
      (Call . D:3 \count)))
  (Call (Call . d:4 \bad))
  (Call (Call . console \log) (Call cat "fixed is still " (Call . d:4 \fixed)))
  #void)
error 334..339: Member fixed defined in D incompatible with usage
log C 2 3 1
log fixed is still 0

