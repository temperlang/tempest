=== closures capture variables, each pass of a loop its own
let fs = new ListBuilder<fn (): Int>();
var i = 0;
while (i < 3) {
  let j = i;
  fs.add(fn (): Int { j * 10 });
  i += 1;
}
console.log(fs.toList().map { (f): String => "${f()}" }.join(" ") { it => it });
let counter(start: Int): fn (): Int {
  var n = start;
  fn (): Int { n += 1; n }
}
let c = counter(5);
c();
console.log("${c()} ${counter(0)()}");
let adder(x: Int, y: Int = x * 2): fn (): Int { fn (): Int { x + y } }
console.log("${adder(1)()} ${adder(1, 1)()}");
let makeBox(v: Int): Int {
  class Box(public w: Int) {
    public get(): Int { w + v }
    public f: fn (): Int = fn (): Int { this.w * v };
  }
  let b = new Box(2);
  b.get() * 100 + (b.f)()
}
console.log("box ${makeBox(3)}");
