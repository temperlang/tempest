=== jumps out of expressions, orelse and for … of bodies
var total = 0;
for (var k = 0; k < 10; ++k) {
  if (k == 2) { continue; }
  total += k + (if (k == 5) { break } else { 0 });
}
console.log("total ${total}");
let found = do {
  var r = -1;
  outer: for (let xs of [[1, 2], [3, 4], [5]]) {
    for (let x of xs) {
      if (x == 2) { continue outer; }
      if (x == 4) { r = x; break outer; }
    }
  }
  r
};
console.log("found ${found}");
let first(xs: List<Int>): Int {
  for (let x of xs) { if (x > 1) { return x; } }
  -1
}
console.log("first ${first([1, 5, 7])} ${first([])}");
var fails = 0;
for (var m = 3; m >= 0; --m) {
  let q = (10 / (m - 2)) orelse do { fails += 1; if (m == 3) { 0 } else { break } };
  console.log("q ${q}");
}
console.log("fails ${fails}");
