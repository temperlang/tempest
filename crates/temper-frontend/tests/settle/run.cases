Panicked: index 3 out of bounds for length 3

=== for of, with jumps (Kotlin fails continue outer at run time)
let f(): String {
  var out = "";
  outer: for (let xs of [[1, 2, 3], [4, 5], [6]]) {
    for (let x of xs) {
      if (x == 2) { continue; }
      if (x == 4) { continue outer; }
      if (x == 6) { break outer; }
      out = "${out}${x}";
    }
    out = "${out};";
  }
  for (let y of [7, 8, 9]) {
    if (y == 8) { break; }
    out = "${out}${y}";
  }
  out
}
console.log(f());
--- settled
(Block
  (Let
    ^f:0
    (Fn
      String
      (Block
        (Var ^out:1 "")
        (Block
          (Loop
            (Block
              (Call
                (Call
                  .
                  (Call list (Call list 1 2 3) (Call list 4 5) (Call list 6))
                  \forEach)
                (Fn
                  (Let ^xs:2)
                  (Block
                    (Loop
                      (Block
                        (Call
                          (Call . xs:2 \forEach)
                          (Fn
                            (Let ^x:3)
                            (Block
                              (If
                                (Call == x:3 2)
                                (Block (Continue @90) #void)
                                (Block))
                              (If
                                (Call == x:3 4)
                                (Block (Continue @43) #void)
                                (Block))
                              (If
                                (Call == x:3 6)
                                (Block (Break @36) #void)
                                (Block))
                              (Assign out:1 (Call cat out:1 x:3))
                              #void)))
                        (Break @90)))
                    (Assign out:1 (Call cat out:1 ";"))
                    #void)))
              (Break @43))))
        (Loop
          (Block
            (Call
              (Call . (Call list 7 8 9) \forEach)
              (Fn
                (Let ^y:4)
                (Block
                  (If (Call == y:4 8) (Block (Break @274) #void) (Block))
                  (Assign out:1 (Call cat out:1 y:4))
                  #void)))
            (Break @274)))
        out:1)))
  (Call (Call . console \log) (Call f:0))
  #void)
log 13;7

=== ListBuilder
let b = new ListBuilder<String>();
b.add("a"); b.add("c"); b.add("b", 1);
b[0] = "z";
console.log(b.join(",") { x => x });
console.log(b.splice(1, 1).join(",") { x => x });
console.log(b.join(",") { x => x });
console.log("${"a" <=> "b"} ${"b" <=> "b"} ${2 <=> 1}");
let sorted = [3, 1, 2, 1].sorted { a, b => a - b };
console.log(sorted.join(",") { x => "${x}" });
b.sort { a, b => b <=> a };
b.reverse();
console.log("${b.removeLast()} ${b.length}");
for (let x of b.toList()) { console.log(x); }
--- settled
(Block
