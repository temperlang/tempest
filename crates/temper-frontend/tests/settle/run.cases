check { x => x.isEmpty };
let applyM<A, B>(x: A, m: Mapper<A, B>): B { m(x) }
let doubled: String = applyM(4) { x => (x * 2).toString() };
console.log(doubled);
class Holder(public p: Pred) {
  public run(s: String): Boolean { p(s) }
}
