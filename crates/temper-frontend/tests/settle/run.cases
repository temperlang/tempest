  (Call (Call . b:0 \add) "c")
  (Call (Call . b:0 \add) "b" 1)
  (Call (Call . b:0 \set) 0 "z")
  (Call
    (Call . console \log)
    (Call (Call . b:0 \join) "," (Fn (Let ^x:2) (Block x:2))))
  (Call
    (Call . console \log)
    (Call
      (Call . (Call (Call . b:0 \splice) 1 1) \join)
      ","
      (Fn (Let ^x:3) (Block x:3))))
  (Call
    (Call . console \log)
