=== Map, MapBuilder and Pair
let m = new Map([new Pair(2, "two"), new Pair(1, "one"), new Pair(2, "deux")]);
console.log("${m.length} ${m[2]} ${m.has(3)} ${m[3] orelse "none"} ${m.getOr(3, "?")}");
console.log(m.keys().join(",") { k => k.toString() });
console.log(m.toListWith { k, v => "${k}=${v}" }.join(" ") { it => it });
let b = m.toMapBuilder();
b["a"] = "x";
b[1] = "uno";
console.log("${b.remove(2)} ${b.remove(2) orelse "gone"} ${b.length} ${m.length}");
b.forEach { k, v => console.log("${k}: ${v}") };
let p = b.toList()[0];
console.log("${p.key} ${p.value} ${p is Pair} ${b is Mapped} ${m is MapBuilder}");
