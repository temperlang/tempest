=== a functional interface, called through a field
@fun interface Sink<T>(item: T): Void;
class Hub<T> {
  private sinks: ListBuilder<Sink<T>> = new ListBuilder<Sink<T>>();
  public on(sink: Sink<T>): Void { sinks.add(sink); }
  public send(item: T): Void { sinks[0](item) }
}
let hub = new Hub<Int>();
hub.on { item => console.log("got ${item.toString()}"); };
hub.send(1);
