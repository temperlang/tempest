=== ?? and ?. evaluate their subject once
var calls = 0;
let maybe(n: Int?): Int? { calls += 1; n }
class B(public n: Int) { public plus(k: Int): Int { n + k } }
let b(n: Int?): B? { calls += 1; if (n == null) { null } else { new B(n as Int) } }
console.log("${maybe(1) ?? -1} ${maybe(null) ?? -1} ${b(2)?.n ?? -1} ${b(null)?.plus(1) ?? -1} ${b(3)?.plus(1)}");
console.log(calls.toString());
--- settled
(Block
  (Var ^calls:0 0)
  (Let
    ^maybe:1
    (Fn
      (Let ^n:4 (Call ? Int))
      (Call ? Int)
      (Block (Assign calls:0 (Call + calls:0 1)) n:4)))
  (Class
    ^B:2
    (Param ^n:6 Int)
    (Method ^plus:7 (Fn (Let ^k:8 Int) Int (Block (Call + n:6 k:8)))))
  (Let
    ^b:3
    (Fn
      (Let ^n:9 (Call ? Int))
      (Call ? B:2)
      (Block
        (Assign calls:0 (Call + calls:0 1))
        (If
          (Call == n:9 null)
          (Block null)
          (Block (Call new B:2 (Call as n:9 Int)))))))
  (Call
    (Call . console \log)
    (Call
      cat
      (Block
        (Let ^subject#10 (Call maybe:1 1))
        (If (Call == subject#10 #null) (Call - 1) subject#10))
      " "
      (Block
        (Let ^subject#11 (Call maybe:1 null))
        (If (Call == subject#11 #null) (Call - 1) subject#11))
      " "
      (Block
        (Let
          ^subject#12
          (Block
            (Let ^subject#13 (Call b:3 2))
            (If (Call == subject#13 #null) #null (Call . subject#13 \n))))
        (If (Call == subject#12 #null) (Call - 1) subject#12))
