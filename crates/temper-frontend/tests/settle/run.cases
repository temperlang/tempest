=== a method's trailing block goes where typing places it
class Runner {
  public m(f: fn (): Void, n: Int = 0): Void {
    console.log("m ${n.toString()}");
    f();
  }
  public h(n: Int, s: String = "d", g: (fn (): Void)? = null): Void {
    console.log("h ${n.toString()} ${s}");
    if (g != null) { g(); }
  }
  public static k<T>(x: T, f: fn (T): String, n: Int = 0): Void {
    console.log("k ${f(x)} ${n.toString()}");
  }
}
let o = new Runner();
o.m(1) { console.log("block 1") };
o.m { console.log("block 2") };
o.h(3) { console.log("block 3") };
o.h(4, "e") { console.log("block 4") };
Runner.k("x", 5) { s => "${s}${s}" };
let top(n: Int, s: String = "d", g: (fn (): Void)? = null): Void {
  console.log("top ${n.toString()} ${s}");
  if (g != null) { g(); }
}
top(6) { console.log("block 6") };
class Holder(public f: fn (): Void, public n: Int = 0) {}
let held = new Holder(7, fn (): Void { console.log("block 7") });
console.log(held.n.toString());
let g = held.f;
g();
