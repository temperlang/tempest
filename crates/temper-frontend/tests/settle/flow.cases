=== is checks narrow to types
interface I {}
class D extends I {
  public dm(): Int { 1 }
  @operator("==") public eq(other: D): Boolean { true }
}
let takeD(d: D): Void {}
let takeI(i: I): Void {}
let b1(i: I): Void { if (i is D) { let d: D = i; takeD(i); } }
let b2(i: I): Int { if (i is D) { i.dm() } else { 0 } }
let b3(i: I?): Void { if (i is D) { takeD(i); } }
let b4(i: I): Void { if (!(i is D)) { takeI(i); } else { takeD(i); } }
let b5(i: I): Void { when (i) { is D -> takeD(i); else -> void; } }
let b6(i: I): D { if (i is D) { i } else { panic() } }
let b7(i: I): Void { if (i is D) { let k = fn (): Void { takeD(i) }; k(); } }
let b8(i: I, d: D): Boolean { if (i is D) { i == d } else { false } }
// Not narrowed, as in Kotlin Temper.
let c1(i: I): Void { var v = i; if (v is D) { takeD(v); } }
let c2(i: I): Void { if (i is D) { void } else { takeD(i); } }
let c3(i: I): Void { if (i is D) { void }; takeD(i); }
let c4(i: I, j: I): Void { if (i is D) { takeD(j); } }
let c5(i: I): D { i }
let c6(i: I): Boolean { i == i }
// Narrowed beyond Kotlin Temper.
let e1(d: D): Int { if (d is I) { d.dm() } else { 0 } }
let e2(i: I): Void { if (i is D && i != null) { takeD(i); } }
let e3(i: I): Void { if (!(i is D)) { return; }; takeD(i); }
let e4(i: I, b: Boolean): Void {
  if (b) { if (!(i is D)) { return; } } else { if (!(i is D)) { return; } };
  takeD(i);
}
let e5(i: I?, b: Boolean): Void {
  if (b) { if (i == null) { return; } } else { if (!(i is D)) { return; } };
  takeI(i);
  takeD(i);
}
