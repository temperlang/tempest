=== what isn't narrowed
let take(s: String): Void {}
let c1(a: String?): Void { var b = a; if (b != null) { take(b) } }
let c2(a: String?): Void { let c = a != null; if (c) { take(a) } }
let c3(a: String?): Void { if (a is String?) { take(a) } }
let c4(a: String?, b: String?): Void { if (a != null || b != null) { take(a) } }
let c5(a: String?): Void {
  label: do { if (a == null) { break label; }; take(a); }
  take(a);
}
let c6(a: String?): Void {
  do { if (a == null) { bubble() } } orelse void;
  take(a);
}
let c7(a: String?): Void { while (a == null) { take(a) } }
let c8(a: String?): Void { while (a == null) { return; }; take(a) }
