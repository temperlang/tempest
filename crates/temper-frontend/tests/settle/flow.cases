=== values Kotlin Temper works out while compiling
let take(s: String): Void {}
let any(s: AnyValue): Void {}
let maybe(x: Int): String? { if (x > 0) { "a" } else { null } }
let e1(): Void { let c: String? = "q"; take(c) }
let e2(): Void { var c: String? = "q"; take(c) }
let e3(): Void { take(maybe(1)) }
let e4(y: Int): Void { take(maybe(y)) }
let e5(a: String?): AnyValue { any(a); a }
let e6(): Void { var c: String? = "q"; c = "r"; take(c) }
