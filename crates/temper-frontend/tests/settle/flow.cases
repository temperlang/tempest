=== functions get the facts at their block's start, closures where they're made
let take(s: String): Void {}
let run(f: fn (): String): String { f() }
let f1(a: String?): Void {
  if (a == null) { return; };
  let g(): String { a }
  take(g());
  take(run(fn (): String { a }));
}
