let fallback(s: String = "d"): Void {}
let b1(a: String?): String { a }
let b2(a: String?): Void { take(a) }
let b3(a: String?): Void { let b: String = a; }
let b4(a: String?): String { return a }
let b5(a: String?): Void { var b: String = ""; b = a; }
let b6(a: String?): Void { let b = a; take(b) }
let b7(a: String?): Void { fallback(a) }
let b8(a: String?): Void { let g: fn (String): Void = take; g(a) }
let b9(a: Int?): String { a }
