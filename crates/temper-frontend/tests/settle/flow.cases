=== narrowed beyond Kotlin Temper
let take(s: String): Void {}
let d1(a: String?): Void { if (a != null && a != "") { take(a) } }
let d2(a: String?, b: String?): Void { if (a != null && b != null) { take(a); take(b) } }
let d3(a: String?): Void { if (!(a != null)) { return; }; take(a) }
let d4(a: String?): Void { if (a == null) { return; }; take(a) }
let d5(a: String?): Void { if (a == null || a == "") { return; }; take(a) }
let d6(a: String?): Void { while (a != null) { take(a); break; } }
let d7(a: String?): Void throws Bubble { if (a == null) { bubble() }; take(a) }
let d8(a: String?): Void { if (a == null) { panic() } else { take(a) } }
