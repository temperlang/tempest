# Flow facts: null checks and `is` checks narrow the uses of locals that
# can't be assigned again, so a nullable value where a non-null one is
# wanted is reported as Kotlin Temper does. Inputs were also built with
# Kotlin Temper; where it narrows less, as through `&&` or after an early
# `return`, it reports errors that these cases don't.
=== null checks narrow
let take(s: String): Void {}
let a1(a: String?): String { if (a != null) { a } else { "" } }
let a2(a: String?): String { if (a == null) { "" } else { a } }
let a3(a: String?): String { if (!(a == null)) { a } else { "" } }
let a4(a: String?): Void { if (null != a) { take(a) } }
let a5(a: String?): Void { if (a is String) { take(a) } }
let a6(a: String?): Void { when (a) { null -> take("x"); else -> take(a) } }
let a7(a: String?): String { a ?? "" }
let a8(a: String?): Void { if (a != null) { let f(): String { a }; take(f()) } }
let a9(a: String?): Void { let b = a; if (b != null) { take(b) } }
let a10(x: Int?, y: Int): Int {
  if (x == null) { 0 } else if (x == 0 && y == 0) { 1 } else { x + y }
}
let a11(a: String?): Void { if (a != null) { take(a) } else { take(a) } }
