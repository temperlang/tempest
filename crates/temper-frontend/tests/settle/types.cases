=== function results
let count(): Void { var n = 0; n += 1 }
let bump(): Void { var n = 0; n++ }
let one(): Int { 1 }
let ignored(): Void { one() }
let dropped(): Void { one(); }
let pick(c: Boolean): Int { if (c) { 1 } else { "x" } }
let early(c: Boolean): Int { if (c) { return 1 }; return "y" }
let nothing(): Int { return }
let either(c: Boolean): String { do { 1 } orelse "z" }
let cases(c: Boolean): Int { when (c) { true -> 1; else -> "w" } }
let loops(): Int { while (true) { return 1 } }
let stops(): Int { panic() }
let fine(x: Int): Boolean { x == 1 || x > 3 }
let fallback(x: Int?): Int { x ?? 1 }
--- settled
(Block
  (Let ^count:0 (Fn Void (Block (Var ^n:14 0) (Assign n:14 (Call + n:14 1)))))
  (Let
    ^bump:1
    (Fn
      Void
      (Block
        (Var ^n:15 0)
        (Block (Let ^t#16 n:15) (Assign n:15 (Call + t#16 1)) t#16))))
  (Let ^one:2 (Fn Int (Block 1)))
  (Let ^ignored:3 (Fn Void (Block (Call one:2))))
  (Let ^dropped:4 (Fn Void (Block (Call one:2) #void)))
  (Let
    ^pick:5
    (Fn (Let ^c:17 Boolean) Int (Block (If c:17 (Block 1) (Block "x")))))
  (Let
    ^early:6
    (Fn
      (Let ^c:18 Boolean)
      Int
      (Block (If c:18 (Block (Return @214 1)) (Block)) (Return @214 "y"))))
  (Let ^nothing:7 (Fn Int (Block (Return @277 #void))))
  (Let ^either:8 (Fn (Let ^c:19 Boolean) String (Block (Orelse (Block 1) "z"))))
  (Let
    ^cases:9
    (Fn (Let ^c:20 Boolean) Int (Block (Block (If (Call == c:20 true) 1 "w")))))
  (Let
    ^loops:10
    (Fn Int (Block (Loop (If true (Block (Return @429 1)) (Break @448))))))
  (Let ^stops:11 (Fn Int (Block (Call panic))))
  (Let
    ^fine:12
    (Fn
      (Let ^x:21 Int)
      Boolean
      (Block (If (Call == x:21 1) #true (Call > x:21 3)))))
  (Let
    ^fallback:13
    (Fn
      (Let ^x:22 (Call ? Int))
      Int
      (Block (Block (If (Call == x:22 #null) 1 x:22))))))
