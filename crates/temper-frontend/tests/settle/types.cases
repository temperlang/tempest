// `h(1) { … }` passes the block as `g`, past `s`, which takes its
// default, as Kotlin's applicationOrderForActuals places it, so `x` is an
// Int32 and the literal's result is checked against `g`'s. Kotlin's typer
// crashes on these calls (a NullPointerException in typeCallByParts2).
let h(n: Int, s: String = "d", g: (fn (Int): Int)? = null): Int { n }
class C {
  public m(n: Int, s: String = "d", g: (fn (Int): Int)? = null): Int { n }
}
h(1) { x => x + 1 };
h(1) { x => "a" };
new C().m(1) { x => "a" };
