=== function literals typed from the type wanted, as Kotlin Temper reports them
// Target typing: a function literal's parameters without types, and its
// result without one, take the function type its place wants: a
// declared type, a function's result, or a callee's parameter, with a
// trailing block placed as Kotlin places it (b1, b2), and a generic
// callee's solved from its other arguments (c4, d1) or the type wanted
// (c3, d2). A literal's result that isn't the one wanted is reported,
// and a literal argument is checked as other arguments are. The input
// was also built with Kotlin Temper: every error matches in message and
// position, except that Kotlin reports a result at an empty position at
// the start of the body, and says "No type for expr" for b4.
let apply(f: fn (Int): Int): Int { f(1) }
let pred(f: fn (Int): Boolean): Boolean { f(1) }
let maybe(f: fn (Int): Int, n: Int = 1): Int { f(n) }
let late(n: Int, f: fn (String): Int): Int { f("") }
let gen<T>(x: T, f: fn (T): T): T { f(x) }
let lists(f: fn (Int): List<String>): Int { 1 }
class C {
  public conv<T>(f: fn (Int): T): T { f(1) }
}
let maker(): fn (Int): Int { fn (x) { "b" } }
let f(ls: List<Int>, c: C): Void {
  let a1 = apply { x => x + 1 };
  let a2 = apply { x => "a" };
  let a3 = pred { x => x };
  let a4 = apply { x => if (x > 0) { "a" } else { "b" } };
  let a5 = apply(fn (s: String): Int { 1 });
  let a6 = apply { (s: String): Int => 1 };
  let a7 = apply { x, y => x };
  let a8 = apply(fn (x: Int): String { "" });
  let a9 = apply { x => let y = x; y + "a" };
  let b1 = maybe { x => "a" };
  let b2 = maybe(2) { x => "b" };
  let b3 = late(1) { x => x };
  let b4 = lists { x => [1] };
  let c1 = ls.join(",") { x => x };
  let c2 = ls.filter { x => x };
  let c3: List<String> = ls.map { x => x * 2 };
  let c4 = ls.reduceFrom(0) { a, b => "a" };
  let c5 = ls.reduceFrom("") { a, b => a + b };
  ls.forEach { x => x + 1 };
  let d1 = gen(1) { x => "a" };
  let d2: String = c.conv { x => x };
  let g1: fn (Int): Int = fn (x) { "a" };
}
