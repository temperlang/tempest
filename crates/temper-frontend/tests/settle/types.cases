=== @fun interfaces keep Kotlin Temper's rules for them
// Kotlin Temper documents these rules (its `FunDecorator.kt`) but
// checks only the type parameter of `apply` (Gen), as for any
// interface's method, and accepts `is` and `as` checks of one.
interface Other {}
@fun interface Sup extends Other { apply(x: Int): Boolean; }
@fun interface Any2 extends AnyValue { apply(x: Int): Boolean; }
@fun interface Two { apply(x: Int): Boolean; other(x: Int): Int; }
@fun interface Prop { apply(x: Int): Boolean; n: Int; }
@fun interface St { apply(x: Int): Boolean; static k: Int = 1; }
@fun interface Getter { apply(x: Int): Boolean; get g(): Int; }
@fun interface Gen { apply<T>(x: T): Boolean; }
@fun interface NoApply { run(x: Int): Boolean; }
@json @fun interface Js(x: Int): Boolean;
@fun interface Pred(x: Int): Boolean;
let b1(a: AnyValue): Boolean { a is Pred }
let b2(a: AnyValue): Boolean { a is Pred? }
let b3(a: AnyValue): Pred throws Bubble { a as Pred }
