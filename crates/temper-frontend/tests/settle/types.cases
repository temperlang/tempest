=== calling a function value that may be null, as Kotlin Temper reports it
export let hi(i: Int, act: (fn (Int): Void)?): Void {
  if (i == 0 || act != null) {
    // `||` means act could be null here.
    act(i);
  }
  if (act != null) {
    act(i);
  }
}
@fun interface Act(i: Int): Void;
let ho(act: Act?): Void {
  act(1);
