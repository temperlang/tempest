=== types that may bubble are written as Temper writes them
// Kotlin Temper writes `fn (Int32): (Int32 | Bubble)` and
// `fn: (Int32 | Bubble)` here.
let g(x: Int): Int throws Bubble { x }
let k(): Int throws Bubble { 1 }
let a: Int = g;
let b: Int = k;
let h(f: fn (Int): Int throws Bubble): Void {}
h(1);
--- settled
(Block
  (Let ^g:0 (Fn (Let ^x:5 Int) (Call throws Int Bubble) (Block x:5)))
  (Let ^k:1 (Fn (Call throws Int Bubble) (Block 1)))
  (Let ^a:2 Int g:0)
  (Let ^b:3 Int k:1)
  (Let
    ^h:4
    (Fn (Let ^f:6 (Call FnType Int (Call throws Int Bubble))) Void (Block)))
  (Call h:4 1)
  #void)
error 176..177: Cannot assign to Int32 from fn (Int32): Int32 throws Bubble
error 192..193: Cannot assign to Int32 from fn: Int32 throws Bubble
error 244..245: Expected subtype of fn (Int32): Int32 throws Bubble, but got Int32

=== Void expressions as values, as Kotlin Temper reports them
let a = [b()];
let b(): Void { console.log("hi"); }
let c(d: Void): Void { b() }
let e = c(a[0]);
c(void);
let f(): Void {
  let x = b();
  var y: Int = 1;
  let z = do { y += 1 } while (y < 3);
  let g(n: Int): Int { n }
  g(b());
}
let h(x: Void): Boolean { x is Int }
let k(): Void { return b(); }
let m(): Void { b() }
let n(): Int { let q: Void = b(); 1 }
let p(cond: Boolean): String { if (cond) { b() }; "s" }
let r(): Void { let w = if (true) { b() } else { b() }; }

let i(): Int { 1 }
let f2(): Void {
  var y: Void = void;
  y = b();
  console.log(b());
  let eq = b() == b();
  let l = [1, b()];
  let t = i() + b();
}
let g2(): Int { return b(); }
let k2(): Void { let x: Void = void; }
let m2(): Void { void }
let n2(): Void { let u = i(); u; }
let p2(): Void { let w = do { b() } orelse do { b() }; }
let q2(x: Int): Void { let v = when (x) { 1 -> b(); else -> b() }; }
