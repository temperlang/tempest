=== function results
let count(): Void { var n = 0; n += 1 }
let bump(): Void { var n = 0; n++ }
let one(): Int { 1 }
let ignored(): Void { one() }
let dropped(): Void { one(); }
let pick(c: Boolean): Int { if (c) { 1 } else { "x" } }
let early(c: Boolean): Int { if (c) { return 1 }; return "y" }
let nothing(): Int { return }
let either(c: Boolean): String { do { 1 } orelse "z" }
let cases(c: Boolean): Int { when (c) { true -> 1; else -> "w" } }
let loops(): Int { while (true) { return 1 } }
let stops(): Int { panic() }
let fine(x: Int): Boolean { x == 1 || x > 3 }
let fallback(x: Int?): Int { x ?? 1 }
--- settled
(Block
  (Let ^count:0 (Fn Void (Block (Var ^n:14 0) (Assign n:14 (Call + n:14 1)))))
