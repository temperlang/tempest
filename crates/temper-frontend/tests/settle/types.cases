(Block
  (If 1 (Block (Call (Call . console \log) "no")) (Block))
  (Var ^n:0 2)
  (Loop (If n:0 (Block (Assign n:0 (Call - n:0 1))) (Break @40)))
  (Let ^b:1 (Call == n:0 1))
  (If b:1 (Block (Call (Call . console \log) "yes")) (Block)))
