=== explicit return types required
let top(x: Int) { x }
let outer(): Int {
  let local(x: Int) { x }
  local(1)
}
let lambda = fn (x: Int) { x };
let typed: fn (Int): Int = fn (x: Int) { x };
class C {
  public method() { 1 }
  public get getter() { 2 }
  public typed(): Int { 3 }
}
let apply(g: fn (Int): Int): Int { g(1) }
apply(fn (x: Int) { x });
apply { (x: Int) => x };
for (let x of [1, 2]) { console.log(x.toString()) }
--- settled
(Block
  (Let ^top:0 (Fn (Let ^x:6 Int) (Block x:6)))
  (Let
    ^outer:1
    (Fn
      Int
      (Block (Let ^local:7 (Fn (Let ^x:8 Int) (Block x:8))) (Call local:7 1))))
  (Let ^lambda:2 (Fn (Let ^x:9 Int) (Block x:9)))
  (Let ^typed:3 (Call FnType Int Int) (Fn (Let ^x:10 Int) (Block x:10)))
  (Class
    ^C:4
    (Method ^method:12 (Fn (Block 1)))
    (Get ^getter:13 (Fn (Block 2)))
    (Method ^typed:14 (Fn Int (Block 3))))
  (Let
    ^apply:5
    (Fn (Let ^g:15 (Call FnType Int Int)) Int (Block (Call g:15 1))))
  (Call apply:5 (Fn (Let ^x:16 Int) (Block x:16)))
  (Call apply:5 (Fn (Let ^x:17 Int) (Block x:17)))
  (Loop
    (Block
      (Call
        (Call . (Call list 1 2) \forEach)
        (Fn
          (Let ^x:18)
          (Block (Call (Call . console \log) (Call (Call . x:18 \toString))))))
      (Break @343))))
