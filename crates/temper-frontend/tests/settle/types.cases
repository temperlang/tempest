=== named @fun interfaces are nominal
// A value of one `@fun` interface isn't another's, even where their
// `apply`s' signatures match (c, l2, p2, r2, r6, ret, mapped), and the
// error suggests the function literal that adapts it (c2, r3). A
// function literal or a trailing block takes its interface from the type
// wanted, as does a reference to a declared function or method (p, l,
// r1, r5, pick, p4), as Java's method references do. Bare function types
// stay structural (f2, p3). `Long` is declared in the long form, and
// works as the short form does. Kotlin Temper reports none of these
// errors, and rejects the method references ("Member isBig defined in K
// incompatible with usage").
@fun interface Pred(x: Int): Boolean;
@fun interface Check(y: Int): Boolean;
@fun interface Long { apply(x: Int): Boolean; }
@fun interface Mapper<A, B>(a: A): B;
let isPos(x: Int): Boolean { x > 0 }
let keep(p: Pred, n: Int): Boolean { p(n) }
let keepC(c: Check, n: Int): Boolean { c(n) }
let keepL(n: Int, l: Long): Boolean { l(n) }
let applyM<A, B>(x: A, m: Mapper<A, B>): B { m(x) }
class K {
  public isBig(x: Int): Boolean { x > 9 }
  public pick(): Pred { isBig }
}
let p: Pred = isPos;
let c: Check = p;
let c2: Check = fn (y) { p(y) };
let l: Long = isPos;
let l2: Long = p;
let p2: Pred? = c2;
let r1 = keep(isPos, 1);
let r2 = keepC(p, 2);
let r3 = keepC(fn (y) { p(y) }, 3);
let r4 = keep(4) { x => x > 1 };
let r5: Boolean = applyM(5, isPos);
let r6: Boolean = applyM(6, p);
let r7 = keepL(7) { x => x > 8 };
let ret(): Check { p }
let mapped: Mapper<Int, Boolean> = l;
let f2: fn (Int): Boolean = p;
let p3: Pred = f2;
let k = new K();
let p4: Pred = k.isBig;
console.log("${r1} ${r3} ${r4} ${r5} ${r7} ${l(1)} ${c2(-1)}");
console.log("${k.pick()(10)} ${p4(3)} ${p3(1)}");
--- settled
