=== function types compared part by part, as Kotlin Temper reports them
// Parameters are compared contravariantly and results covariantly, as
// Kotlin does, but only what that rejects is reported, until it's settled
// whether function types are invariant too: `f3` and `f5` pass. A
// function that may bubble isn't one that doesn't, though the reverse
// passes (`f8`), and one with an optional parameter is one that takes it
// (`f10`), but not one that leaves it out (`f9`).
interface Animal {}
class Dog extends Animal {}
let isEven(x: Int): Boolean { x % 2 == 0 }
let isShort(s: String): Boolean { s == "" }
let toDog(x: Int): Dog { new Dog() }
let toAnimal(x: Int): Animal { new Dog() }
let takesAnimal(a: Animal): Int { 1 }
let takesDog(d: Dog): Int { 1 }
let idInt(x: Int): Int { x }
let mayFail(x: Int): Int throws Bubble { x / 0 }
let opt(x: Int, y: Int = 2): Int { x + y }
let wrapList(x: Int): List<Int> { [x] }
let f1: fn (Int): Boolean = isShort;
let f2: fn (Int): Dog = toAnimal;
let f3: fn (Int): Animal = toDog;
let f4: fn (Animal): Int = takesDog;
let f5: fn (Dog): Int = takesAnimal;
let f6: fn (Int): Int = mayFail;
let f7: fn (Int): Int throws Bubble = takesDog;
let f8: fn (Int): Int throws Bubble = idInt;
let f9: fn (Int): Int = opt;
let f10: fn (Int, Int): Int = opt;
let f11: fn (Int, Int, Int): Int = opt;
let f12: fn (Int): List<String> = wrapList;
let f13: fn (Int?): Boolean = isEven;
let f14: fn (Int): Void = isEven;
let f15: fn (): Int = idInt;
let f16: (fn (Int): Boolean)? = isShort;
let f17: fn (Int): Boolean = fn (s: String): Boolean { true };
let f18: fn (Int): Boolean = fn (x: Int): Boolean throws Bubble { bubble() };
let useF(f: fn (Int): Boolean): Boolean { f(1) }
let pass(g: fn (String): Boolean): Boolean { useF(g) }
let mk(): fn (Int): Boolean { isShort }
var f19: fn (Int): Boolean = isEven;
f19 = isShort;
let ls: List<Int> = [1, 2];
let evens = ls.filter(isShort);
