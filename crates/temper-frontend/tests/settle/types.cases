  (Let ^one:2 (Fn Int (Block 1)))
  (Let ^ignored:3 (Fn Void (Block (Call one:2))))
  (Let ^dropped:4 (Fn Void (Block (Call one:2) #void)))
  (Let
    ^pick:5
    (Fn (Let ^c:17 Boolean) Int (Block (If c:17 (Block 1) (Block "x")))))
  (Let
    ^early:6
    (Fn
      (Let ^c:18 Boolean)
      Int
      (Block (If c:18 (Block (Return @214 1)) (Block)) (Return @214 "y"))))
  (Let ^nothing:7 (Fn Int (Block (Return @277 #void))))
  (Let ^either:8 (Fn (Let ^c:19 Boolean) String (Block (Orelse (Block 1) "z"))))
  (Let
    ^cases:9
    (Fn (Let ^c:20 Boolean) Int (Block (Block (If (Call == c:20 true) 1 "w")))))
  (Let
    ^loops:10
    (Fn Int (Block (Loop (If true (Block (Return @429 1)) (Break @448))))))
  (Let ^stops:11 (Fn Int (Block (Call panic))))
  (Let
    ^fine:12
    (Fn
