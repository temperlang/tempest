=== object literals take their class from the type wanted
// Target typing: where a class is wanted, an object literal makes it, if
// its constructor takes every name, so `a` and `b` pick between A and B,
// which Kotlin Temper reports as "Multiple types have matching
// constructors: A, B"; where an interface is wanted, the one class found
// that implements it. Nested literals, list elements and values held in
// temporaries, as in `p`, take the types their places want. Where the
// names fit only another class, as in `bad`, that's an error, which
// Kotlin Temper reports at the same position as "Cannot assign to A from
// Mark". Without a type wanted, as for `amb`, Kotlin's rule applies.
class A(public x: Int) {
  public toString(): String { "A ${x}" }
}
class B(public x: Int, public y: Int = 0) {
  public toString(): String { "B ${x} ${y}" }
}
interface Shape {}
class Square(public side: Int) extends Shape {
  public toString(): String { "Square ${side}" }
}
class Lot(public side: Int) {}
class Pair(public a: A, public b: B) {
  public toString(): String { "${a} ${b}" }
}
class Holder(public a: A = { x: 9 }) {}
class Box<T>(public value: T) {}
class Mark(public p: Int) {}
let say(s: String): Int { console.log(s); 1 }
let f(b: B): String { b.toString() }
let g(): A { { x: 3 } }
let h(): B { return { x: 4 }; }
let a: A = { x: 1 };
let b: B = { x: 1 };
let n: A? = { x: 5 };
let s: Shape = { side: 2 };
let p: Pair = { b: { x: say("first") }, a: { x: say("second") } };
let xs: List<A> = [{ x: 6 }, { x: 7 }];
var v: B = { x: 1 };
v = { x: 8 };
let bx: Box<Int> = { value: 1 };
console.log("${a} ${b} ${n} ${s} ${p} ${xs[1]} ${v} ${bx.value} ${f({ x: 2 })} ${g()} ${h()} ${new Holder().a}");
let bad: A = { p: 1 };
let bad2: Shape = { p: 1 };
let amb = { x: 1 };
