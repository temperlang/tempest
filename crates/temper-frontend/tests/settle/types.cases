# Static types: declared and inferred types of literals, locals,
# parameters and results, and the type errors Kotlin Temper reports for
# them, with its messages. Input, then the settled tree and diagnostics as
# print::write_settled writes them, then what running it logs; type errors
# don't stop a run.
=== declared types of locals
let a: Int = "a";
let b: Int = 1.5;
let c: Float64 = 1;
let d: Int64 = 1;
let e: Int32 = 1;
var f: String = "f";
f = 3;
let g: Boolean;
g = true;
let h: fn (Int): Int = 1;
--- settled
(Block
  (Let ^a:0 Int "a")
  (Let ^b:1 Int 1.5)
  (Let ^c:2 Float64 1)
  (Let ^d:3 Int64 1)
  (Let ^e:4 Int32 1)
  (Var ^f:5 String "f")
  (Assign f:5 3)
  (Let ^g:6 Boolean)
  (Assign g:6 true)
  (Let ^h:7 (Call FnType Int Int) 1)
  #void)
error 13..16: Cannot assign to Int32 from String
error 31..34: Cannot assign to Int32 from Float64
error 53..54: Cannot assign to Float64 from Int32
error 71..72: Cannot assign to Int64 from Int32
error 113..118: Cannot assign to String from Int32
error 169..170: Cannot assign to fn (Int32): Int32 from Int32

