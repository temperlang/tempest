=== a function literal needs a type wanted
// A function literal takes its type from the type wanted, so one that
// initializes a `let` or `var` without a declared type is an error (f,
// g, h); Kotlin Temper accepts these. A declared function (isPos, inner)
// isn't a literal.
@fun interface Pred(x: Int): Boolean;
let isPos(x: Int): Boolean { x > 0 }
let f = fn (x: Int): Boolean { x > 0 };
let p: Pred = fn (x: Int): Boolean { x > 0 };
let outer(): Boolean {
  var g = fn (x: Int): Boolean { x > 1 };
  let h = fn (x: Int): Boolean { x > 2 };
  let inner(x: Int): Boolean { x > 3 }
  let q: Pred = fn (x) { x > 4 };
  g(1) || h(2) || inner(3) || q(4)
}
console.log("${f(1)} ${p(1)} ${outer()}");
