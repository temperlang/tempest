// Each call binds the function's type parameters, from its type
// arguments or else its arguments' types; a parameter bound two ways is
// left unknown, as Kotlin may find a common supertype. Kotlin folds a
// call of constants first, so `id<Int>("a")` then passes as a `String`.
interface Animal {}
class Dog extends Animal {}
let id<T>(x: T): T { x }
let pair<T>(a: T, b: T): T { a }
let wrap<T>(x: T): List<T> { [x] }
let pick<T extends Animal>(x: T): T { x }
let opt<T>(x: T?): T { x orelse panic() }
let both<T, U>(a: T, b: U): U { b }
let g<T>(x: T, n: Int): T { x }
let k<T>(xs: List<T>, x: T): T { x }
let c1: String = id(1);
let c2: Int = id(1);
let c3 = pair(1, "a");
let c4: Int = id<Int>("a");
let c5: List<String> = wrap(1);
let c6 = pick(1);
let c7: Dog = pick(new Dog());
let c8: String = opt(1);
let c9: String = both(1, 2);
let d1: String = id<Int>(1);
let d2: Animal = id(new Dog());
let d3 = id<Int, Int>(1);
let f(n: Int, s: String, xs: List<Int>): Void {
  g(n, s);
  g(n);
  g<String>(n, s);
  pick(n);
  pick<Dog>(new Dog());
  id<Animal>(new Dog());
  let a: String = g(n, 1);
  k(xs, s);
  let b: String = k(xs, n);
  let c: Int = id(id(s));
  let e: String = id<Int>(n);
  let h: Int = id<Int>(n);
}
