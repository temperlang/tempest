=== calls of known functions
let f(a: Int, b: String = "b"): Void {}
f(1);
f(1, "x", 3);
f();
f("1", 2);
f(1, null);
let apply(g: fn (Int): Int): Int { g("s") }
apply(fn (x: Int): Int { x + 1 });
apply { (x: Int): Int => x + 1 };
let h(x: Int): Int { x }
let i: Int = h;
let j: String = h(1);
--- settled
(Block
  (Let ^f:0 (Fn (Let ^a:5 Int) (Let ^b:6 String "b") Void (Block)))
  (Call f:0 1)
  (Call f:0 1 "x" 3)
  (Call f:0)
  (Call f:0 "1" 2)
  (Call f:0 1 null)
  (Let
    ^apply:1
    (Fn (Let ^g:7 (Call FnType Int Int)) Int (Block (Call g:7 "s"))))
  (Call apply:1 (Fn (Let ^x:8 Int) Int (Block (Call + x:8 1))))
  (Call apply:1 (Fn (Let ^x:9 Int) Int (Block (Call + x:9 1))))
  (Let ^h:2 (Fn (Let ^x:10 Int) Int (Block x:10)))
  (Let ^i:3 Int h:2)
  (Let ^j:4 String (Call h:2 1))
  #void)
