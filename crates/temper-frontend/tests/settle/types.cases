// Each call binds the function's type parameters, from its type
// arguments or else its arguments' types; a parameter bound two ways is
// left unknown, as Kotlin may find a common supertype. Kotlin folds a
// call of constants first, so `id<Int>("a")` then passes as a `String`.
interface Animal {}
class Dog extends Animal {}
let id<T>(x: T): T { x }
let pair<T>(a: T, b: T): T { a }
let wrap<T>(x: T): List<T> { [x] }
let pick<T extends Animal>(x: T): T { x }
let opt<T>(x: T?): T { x orelse panic() }
let both<T, U>(a: T, b: U): U { b }
let g<T>(x: T, n: Int): T { x }
let k<T>(xs: List<T>, x: T): T { x }
