=== users' generic supertypes, as Kotlin Temper reports them
// A class or interface is the types it extends with its own type
// arguments put in: a `Sub2<Int>` is a `Sup2<Int, String>` and so a
// `Sup<String>`, and a `StrHolder`'s `describe` takes a `String`. Kotlin
// can't solve `T` from a `StrHolder` where a `Holder<T>` is wanted, so
// `unwrap(sh)` passes here, as `let n: Int = unwrap(sh)` is the error.
interface Sup<T> {}
class Sub<T> extends Sup<T> {}
interface Sup2<T, U> extends Sup<U> {}
class Sub2<T> extends Sup2<T, String> {}
class Sub4 extends Sup<String> {}
class Wrap<T>(public x: T) extends Sup<T> {}
interface Holder<T> {
  get(): T;
  describe(x: T): String { "h" }
}
class StrHolder(public s: String) extends Holder<String> {
  public get(): String { s }
}
class GenHolder<U>(public u: U) extends Holder<U> {
  public get(): U { u }
}
let f1(sh: StrHolder, gh: GenHolder<Int>): Void {
  let a: Int = sh.describe("x");
  let b: String = sh.describe(1);
  let c: String = gh.describe(2);
  let d: String = gh.describe("y");
  let e: Int = gh.get();
}
let f2(s: Sub<String>, s4: Sub4, s2: Sub2<Int>): Void {
  let a: Sup<String> = s;
  let b: Sup<Int> = s;
  let c: Sup<String> = s4;
  let d: Sup<Int> = s4;
  let e: Sup<String> = s2;
  let g: Sup2<Int, String> = s2;
  let h: Sup2<String, String> = s2;
  let i: Sup<Int> = s2;
  let j: Sub<String> = s4;
}
let takeSup(x: Sup<Int>): Void {}
let unwrap<T>(x: Holder<T>): T { x.get() }
let wrapAll<T>(x: Holder<T>): List<T> { [x.get()] }
let f3(s4: Sub4, s: Sub<String>, sh: StrHolder, gh: GenHolder<String>): Void {
  takeSup(s4);
  takeSup(s);
  let n: Int = unwrap(sh);
  let m: String = unwrap(sh);
  let o: Int = unwrap(gh);
  let ws: List<Int> = wrapAll(sh);
  let k: Sup<Int> = new Sub<String>();
  let w: Sup<String> = new Wrap(1);
  let v: Sup<String> = new Wrap("a");
}
