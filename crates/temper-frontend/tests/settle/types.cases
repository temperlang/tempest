=== returns and bubbling in function literals, as Kotlin Temper reports them
// A function literal without a return type takes its result, and whether
// it may bubble, from the function type its place wants. A value it
// returns that isn't that result is reported, at the value, each return
// on its own (Kotlin: at an empty position just after the `return`, with
// the type of all of them joined, so "but got Int32?" at a2's first
// `return`). Where that type doesn't throw Bubble, what may bubble in its
// body is reported, as for functions that declare their return type. The
// input was also built with Kotlin Temper: every error matches but for
// those positions and a2's, and Kotlin's "but got Top" for a literal
// whose result never returns (a7, b1, b5, b6), which tempest doesn't
// report.
let apply(f: fn (Int): Int): Int { f(1) }
let applyB(f: fn (Int): Int throws Bubble): Int throws Bubble { f(1) }
let eat(f: fn (Int): Void): Void { f(1) }
let f(ls: List<Int>): Void {
  let a1 = apply(fn (x) { return "a"; });
  let a2 = apply(fn (x) {
    if (x > 0) { return x; }
    return null;
  });
  let a3 = apply(fn (x) { return; });
  eat(fn (x) { return x; });
  let a4 = apply(fn (x) { return x + 1; });
  let a5: fn (Int): Int = fn (x) { return "b"; };
  let a6: List<String> = ls.map(fn (x) { return x; });
  let a7 = apply(fn (x) { return panic(); });
  let b1 = apply { x => bubble() };
  let b2 = apply { x => "1".toInt32() };
  let b3 = apply { x => x / 0 };
  let b4 = apply { x => "1".toInt32() orelse 0 };
  let b5 = applyB { x => bubble() } orelse 0;
  let b6 = ls.filter { x => bubble() };
  eat { x => bubble(); };
  let b7: fn (Int): Int = fn (x) { x / 0 };
}
