=== @fun interfaces as the function types they stand for, as Kotlin Temper reports them
// A `@fun` interface's type stands for its `apply`'s signature: a
// function is one of its values where that function type fits, compared
// part by part, and such a value is a function, called as one; two
// `@fun` interfaces' types are never each other's, even where they stand
// for the same function type (q1, q3, q4), a deliberate difference from
// Kotlin, which accepts those; a function is no other class's or
// interface's value (`Plain` isn't `@fun`), nor a class's value a
// function, even one that extends a `@fun` interface (f3). A function
// literal takes its types from one, and a trailing block goes to a
// parameter of one (t6). The input was also built with Kotlin Temper:
// every other error matches but for names (Kotlin: `Pred__0`), the positions of
// a literal's results and returns, at the value (Kotlin: empty, at the
// start of the body or just after the `return`), and Kotlin's "but got
// Top" for p8's result, which tempest doesn't report.
@fun interface Pred(x: String): Boolean;
@fun interface Pred2(y: String): Boolean;
@fun interface IntPred(x: Int): Boolean;
@fun interface Mapper<A, B>(a: A): B;
@fun interface Thrower(x: Int): Int throws Bubble;
interface Plain(x: Int): Int;
class C extends Pred { public apply(x: String): Boolean { true } }
let isShort(s: String): Boolean { s.isEmpty }
let isPos(n: Int): Boolean { n > 0 }
let takeP(p: Pred): Boolean { p("abc") }
let takeTwo(p: Pred, n: Int): Boolean { p("") }
let takeOpt(n: Int, p: Pred? = null): Boolean { true }
let applyM<A, B>(x: A, m: Mapper<A, B>): B { m(x) }
let p1: Pred = isShort;
let p2: Pred = isPos;
let p3: Pred = fn (x) { x.isEmpty };
let p4: Pred = fn (x) { 1 };
let p5: Pred = fn (x: Int): Boolean { true };
let p6: Pred = new C();
let p7: Pred = fn (x) { return 1; };
let p8: Pred = fn (x) { bubble() };
let q1: Pred2 = p1;
let q2: IntPred = p1;
let q3: Mapper<String, Boolean> = p1;
let q4: Pred = q3;
let q5: Mapper<String, Int> = p1;
let f1: fn (String): Boolean = p1;
let f2: fn (Int): Boolean = p1;
let f3: fn (String): Boolean = new C();
let th: Thrower = fn (x: Int): Int throws Bubble { 1 };
let f4: fn (Int): Int = th;
let pl: Plain = isShort;
let m1: Mapper<Int, String> = fn (x) { x.toString() };
let m2: Mapper<Int, String> = fn (x) { x };
let m3: Mapper<Int, String> = isPos;
let t1 = takeP(isShort);
let t2 = takeP(isPos);
let t3 = takeP { x => x.isEmpty };
let t4 = takeP { x => 2 };
let t5 = takeP { x => x + 1 };
let t6 = takeTwo(2) { x => 3 };
let t7 = takeOpt(1) { x => x.isEmpty };
let t8 = takeOpt(1) { x => x + 1 };
let g1: String = applyM(1) { x => x.toString() };
let g2: Int = applyM(1) { x => x.toString() };
let c1: Boolean = p1("a");
let c2: Int = p1("a");
let c3 = p1(1);
let c4: String = m1(2);
