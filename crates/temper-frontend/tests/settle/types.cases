=== where Kotlin Temper's errors are missing, misplaced, or wrong
// Pins of Kotlin Temper bugs (notes/kotlin-differences.md, "Bugs in
// Kotlin Temper"): an `if` value that doesn't fit is reported at the
// `if` (Kotlin: an empty position at the end of the first branch), and a
// narrowed use's error at the use (Kotlin: the branch's end); a function
// argument at top level is checked though the callee never calls it
// (Kotlin runs the call while compiling and misses it); valid code with
// a literal argument then a trailing block passes (Kotlin: "No type for
// expr"); and a literal whose declared result isn't the one wanted says
// so (Kotlin: "No type for expr").
interface I {}
interface J {}
class D extends I {}
let wiI(m: fn (Int): Int): Int { 1 }
let opts(f: fn (Int): Int, g: fn (String): Boolean): Int { if (g("")) { f(1) } else { 0 } }
let chk5(c: Boolean, m: fn (Int): String): String { m(1) }
let s1(c: Boolean): Int {
  let s: String = if (c) { 1 } else { return -1; };
  0
}
let n1(i: I): Void {
  if (i is D) {
    let j: J = i;
  }
}
console.log(wiI(fn (x: Int): String { "" }).toString());
console.log(opts(fn (x: Int): Int { x }) { x => x.isEmpty }.toString());
console.log(chk5(true) { (x): Int => 1 });
