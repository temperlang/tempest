=== generic types and type parameters, as Kotlin Temper reports them
let f1(a: List<Int>): List<String> { a }
let f2(a: Map<String, Int>): Map<String, String> { a }
let f3(a: List<Int>): Int { a }
let f4(a: Int): List<Int> { a }
let f5(a: List<Int>?): List<Int> { a }
let f6(a: List<List<Int>>): List<List<String>> { a }
let f7(a: List<Int>): Void { a }
let f8(a: List<String>): AnyValue { a }
let f9(a: ListBuilder<Int>): Listed<Int> { a }
let g1(a: ListBuilder<Int>): List<Int> { a }
let g2(a: List<Int>): Listed<String> { a }
let g3(a: Listed<Int>): List<Int> { a }
let g4(a: Map<String, Int>): Mapped<String, String> { a }
let g5(a: Generator<Int>): SafeGenerator<Int> { a }
let g6(a: List<Int>): Deque<Int> { a }
let k1(a: String): MapKey<String> { a }
let k2(a: Int): MapKey<Int> { a }
let k3(a: String): MapKey<Int> { a }
class Box<T>(public item: T) {
  public get(): T { item }
  public bad(): Int { item }
  public swap<U>(u: U): T { u }
}
let b1(b: Box<Int>): Box<String> { b }
let b2(b: Box<Int>): Box<Int>? { b }
let p1<T>(x: T): Int { x }
let p2<T>(x: Int): T { x }
let p3<T>(x: T): T? { x }
let p4<T>(x: Int): T { null }
let p5<T>(x: T?): T { x }
let p6<T>(x: T): AnyValue { x }
let p7<T, U>(x: T): U { x }
let p8<T>(x: List<T>): List<Int> { x }
let p9<T>(x: T): Void { x }
interface Animal {}
class Dog extends Animal {}
let q1<T extends Animal>(x: T): Animal { x }
let q2<T extends Animal>(x: T): Dog { x }
let q3<T extends Animal>(x: Dog): T { x }
let q4<T extends Animal>(x: T): Boolean {
  if (x is Dog) { let d: Dog = x; true } else { false }
}
let q5<T, U extends T>(x: U): T { x }
// Kotlin honors List's `@out`; the rule waits for variance.
let v1(a: List<Dog>): List<Animal> { a }
// Calls are solved from their arguments, as in Kotlin.
let id<T>(x: T): T { x }
let c1: String = id(1);
console.log(new Box<String>("a").get());
