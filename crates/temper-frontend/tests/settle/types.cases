// Where the type its place wants binds a type parameter that the result
// wraps, as `List<T>`, a call's arguments are checked against that, as
// Kotlin's solver does; a bare `T` result is solved from the arguments.
// Kotlin misses the error for a call that's an argument, `takeLS(wrap(1))`.
let id<T>(x: T): T { x }
let wrap<T>(x: T): List<T> { [x] }
let takeLS(xs: List<String>): Void {}
