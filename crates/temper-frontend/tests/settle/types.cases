=== a visible @extension keeps its name from being a missing member
// Instance extensions aren't supported yet, but `s.isPal()` isn't "No
// member" where `@extension("isPal")` is visible; `s.isPalindrome()`
// still is, as is `isOdd` where the extension, local to `f`, isn't.
@extension("isPal")
let stringIsPal(s: String): Boolean { s == "aba" }
let f(s: String): Boolean {
  @extension("isOdd") let stringIsOdd(t: String): Boolean { true }
  s.isOdd() && s.isPal() && s.isPalindrome()
}
let g(s: String): Boolean { s.isOdd() }
