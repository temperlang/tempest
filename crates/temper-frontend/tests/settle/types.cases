=== generic classes and methods, as Kotlin Temper reports them
// `new Box(1)` is solved as a call of `<T>(T) -> Box<T>`, a `Box<Int>`'s
// members have `Int` for `T`, and a generic method's call is solved as a
// function's, its receiver shown first. Kotlin fails on a method's
// explicit type arguments (`o.first<String>(ss)`), which tempest binds
// as written.
interface Animal {}
class Dog extends Animal {}
class Box<T>(public item: T) {
  public get(): T { item }
  public put(x: T): Void { }
  public var count: Int = 0;
  public with<U>(u: U): Box<U> { new Box<U>(u) }
  public both<U>(u: U, t: T): U { u }
  public self(): Box<T> { this }
}
class Pair2<A, B>(public a: A, public b: B) {
  public swap(): Pair2<B, A> { new Pair2<B, A>(b, a) }
}
class Order {
  public first<T>(items: List<T>): T { items[0] }
  public pick<T extends Animal>(x: T): T { x }
  public static make<T>(x: T): List<T> { [x] }
  public two<T>(a: T, n: Int): T { a }
}
let b1 = new Box(1);
let b2: Box<String> = new Box(1);
let b3 = new Box<String>(1);
let s1: String = b1.item;
let s2: String = b1.get();
let f(bx: Box<Int>, p: Pair2<Int, String>, o: Order, xs: List<Int>, ss: List<String>): Void {
  bx.put("x");
  bx.count = "y";
  let a: Int = p.b;
  let c: Pair2<Int, String> = p.swap();
  let d: String = bx.count;
  let e: Box<String> = bx.self();
  let g: String = o.first(xs);
  let h = o.pick(1);
  let i: String = Order.make(1);
  let j: String = bx.both(1, 2);
  bx.both(1, "a");
  o.two(1, "a");
  o.two(1);
  let k: Int = o.first<String>(ss);
}
console.log(new Pair2(1, "a").swap().a);
