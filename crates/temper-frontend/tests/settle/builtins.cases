=== what may bubble where it can
let g(x: Int): Int throws Bubble { if (x == 0) { bubble() } else { x } }
let n = 2;
let a1(a: Int): Int throws Bubble { a / a }
let a2(a: Int): Void throws Bubble { bubble() }
let a3(a: Int): Int { (a / a) orelse 0 }
let a4(a: Int): Int { a / n }
let a5(a: Int): Int { a / -3 }
let a6(a: Int): Int { a / (1 + 1) }
let a7(a: Int64): Int64 { a % 2i64 }
let a8(a: Int): Int { let k = 3; a % k }
let a9(): Int { g(1) }
let b1(a: Int): Int { if (false) { bubble() } else { a } }
let b2(a: Int): Int { panic() }
let b3(ls: List<Int>, a: Int): Void throws Bubble {
  for (let x of ls) { console.log("${x / a}"); }
}
let b4(a: Int): Void { let f = fn { bubble() }; }
let b5(a: Int): Int { let f(): Int throws Bubble { a / a }; f() orelse 0 }
console.log("${1 / (n - 2)}") orelse console.log("top level");
