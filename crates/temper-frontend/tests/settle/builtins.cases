      (Block (If (Call == x:16 0) (Block (Fail)) (Block x:16)))))
  (Let ^n:1 2)
  (Let
    ^a1:2
    (Fn (Let ^a:17 Int) (Call throws Int Bubble) (Block (Call / a:17 a:17))))
  (Let ^a2:3 (Fn (Let ^a:18 Int) (Call throws Void Bubble) (Block (Fail))))
  (Let ^a3:4 (Fn (Let ^a:19 Int) Int (Block (Orelse (Call / a:19 a:19) 0))))
  (Let ^a4:5 (Fn (Let ^a:20 Int) Int (Block (Call / a:20 n:1))))
  (Let ^a5:6 (Fn (Let ^a:21 Int) Int (Block (Call / a:21 (Call - 3)))))
  (Let ^a6:7 (Fn (Let ^a:22 Int) Int (Block (Call / a:22 (Call + 1 1)))))
  (Let ^a7:8 (Fn (Let ^a:23 Int64) Int64 (Block (Call % a:23 2i64))))
  (Let ^a8:9 (Fn (Let ^a:24 Int) Int (Block (Let ^k:25 3) (Call % a:24 k:25))))
  (Let ^a9:10 (Fn Int (Block (Call g:0 1))))
  (Let
    ^b1:11
    (Fn (Let ^a:26 Int) Int (Block (If false (Block (Fail)) (Block a:26)))))
