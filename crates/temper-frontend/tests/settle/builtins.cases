=== what may bubble: methods of builtin types, arity, misfits and operators
// Kotlin also says "Cannot bubble" for c9, whose constant argument fails
// when it folds the call, and "Cannot assign to String from StringIndex"
// for d4, a core class tempest doesn't type yet; and counts `this` in
// d2's arity.
let c1(x: Int64): Int { x.toInt32Unsafe() + x.toFloat64() }
let c2(x: Int64): Float64 { x.toFloat64() }
let c3(x: Int64): Int { 1 + x.toInt32() }
let c4(x: Int64): Int { 1.0 + x.toInt32() }
let g(): Int throws Bubble { 1 }
let c5(): Int { 1.0 + g() }
let c6(x: Int): Int { 1.0 + (x / 0) }
let c7(): Int { let s = "1"; s.toInt32() }
let c8(): Int { 1.toString().toInt32() }
let c9(): String { String.fromCodePoint(0x110000) }
let d1(c: Int): String { String.fromCodePoint(c) }
let d2(s: String): Int { s.toInt32(1.0, 2) }
let d3(s: String): Int { s.countBetween(String.begin, s.end) }
let d4(s: String): String { s.end }
let h(x: Int): Int throws Bubble { x }
let e1(y: Int): Int { h(y, 2) }
let e2(y: Int): Int { h("a") }
let e3(y: Int): Int { 1.0 + h(y) }
let e4(y: Int): Int { 1 + h(y) }
let e5(y: Int): Int { -(1.0 + h(y)) }
let e6(y: Int): Int { h(1.0 + h(y)) }
let e7(s: String): Int { s.toInt32(1.0 + s.toInt32()) }
let e8(s: String): Boolean { !(s.toInt32()) }
