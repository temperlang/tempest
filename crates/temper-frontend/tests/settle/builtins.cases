# Builtins' signatures: operators' variants and which one a call picks,
# `!`, `**`, `console.log` and builtin types' methods (as core declares
# them), and what may bubble in a function that
# doesn't declare `throws Bubble`, with Kotlin Temper's messages. Inputs
# were also built with Kotlin Temper; where it reports more, these cases
# say so.
=== operators pick a variant by their arguments, in order
let a1(): Int { 1 + "a" }
let a2(): Int { "a" + 1 }
let a3(): Int { 1.0 + 1 }
let a4(): Int { 1i64 + 1 }
let a5(s: String): Int { s + s }
let a6(x: Int, y: Float64): Int { x - y }
let a7(x: Float64): Int { -x }
let a8(s: String): Int { +s }
let a9(x: Boolean): Int { x * x }
let b1(): Int { 1 + 2 + "a" }
let b2(): Int { (1 + "a") + 2.0 }
let b3(x: Int, v: Void): Int { x + v }
let b4(x: Int?, y: Int): Int { x / y }
let b5(x: Int): Int { null + x }
let b6(x: Int): Int { -null }
var b7 = 1;
b7 += 1.0;
