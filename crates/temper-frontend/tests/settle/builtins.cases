  (Let ^a2:1 (Fn Int (Block (Call + "a" 1))))
  (Let ^a3:2 (Fn Int (Block (Call + 1.0 1))))
  (Let ^a4:3 (Fn Int (Block (Call + 1i64 1))))
  (Let ^a5:4 (Fn (Let ^s:16 String) Int (Block (Call + s:16 s:16))))
  (Let
    ^a6:5
    (Fn (Let ^x:17 Int) (Let ^y:18 Float64) Int (Block (Call - x:17 y:18))))
  (Let ^a7:6 (Fn (Let ^x:19 Float64) Int (Block (Call - x:19))))
  (Let ^a8:7 (Fn (Let ^s:20 String) Int (Block (Call + s:20))))
  (Let ^a9:8 (Fn (Let ^x:21 Boolean) Int (Block (Call * x:21 x:21))))
