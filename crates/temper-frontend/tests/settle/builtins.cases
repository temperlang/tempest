=== builtin types' methods have core's signatures
// Kotlin counts `this` in a8's arity.
let a1(s: String): Int { s.toInt32() }
let a2(x: Int): Int { x.toString() }
let a3(x: Int): String { x.min("a") }
let a4(s: String): Int { s.toInt32("a") }
let a5(s: String): Int { s.isEmpty }
let a6(x: Float64): Int { x.toInt32() }
let a7(x: Float64): Float64 { x.near(1) }
let a8(x: Int): String { x.toString(1, 2) }
let a9(): String { String.fromCodePoint(65) }
let b1(): Int { Float64.pi }
let b2(): Int { "1".toInt32() }
let b3(x: Int64): Int { x.toInt32Unsafe() + x.toFloat64() }
let b4(b: Boolean): Int { b.toString() }
let b5(x: Int): Int { x.signum + x.succ() + x.toFloat64() }
let b6(s: String): String { s.split(1) }
let b7(s: String): Boolean { s.toFloat64() == 1.0 }
let b8(x: Float64): Int { x.abs().atan2(1) }
let b9(s: String): Int { s.toInt32(null) }
--- settled
(Block
  (Let ^a1:0 (Fn (Let ^s:18 String) Int (Block (Call (Call . s:18 \toInt32)))))
  (Let ^a2:1 (Fn (Let ^x:19 Int) Int (Block (Call (Call . x:19 \toString)))))
  (Let ^a3:2 (Fn (Let ^x:20 Int) String (Block (Call (Call . x:20 \min) "a"))))
  (Let
    ^a4:3
