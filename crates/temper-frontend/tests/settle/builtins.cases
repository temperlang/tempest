=== comparisons, equality and bits
let a1(): Boolean { 1 < 1.0 }
let a2(): Boolean { 1.0 >= 1 }
let a3(): Boolean { true < 1 }
let a4(x: Int): Int { x <=> 1.0 }
let a5(x: Int?): Boolean { x <= 1 }
let a6(): Boolean { "a" == 1 }
let a7(x: Int): Boolean { x != 1.0 }
let a8(s: String): Boolean { !(s == 1) }
let a9(x: Int): Int { when (x) { "a" -> 1; else -> 2 } }
let b1(x: String): Int { x & 1 }
let b2(x: String): Int { 1 | x }
let b3(x: Float64): Int { ~x }
let b4(x: Int64): Int64 { x << x }
let b5(x: Int, y: Float64): Int { x >>> y }
