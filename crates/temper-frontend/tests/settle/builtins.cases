  (Let
    ^a5:5
    (Fn
      (Let ^x:16 Int)
      (Let ^y:17 (Call ? Int))
      Boolean
      (Block (Call == x:16 y:17))))
  (Let
    ^a6:6
    (Fn
      (Let ^x:18 Int)
      (Let ^y:19 (Call ? String))
      Boolean
      (Block (Call == x:18 y:19))))
  (Let ^c:7 (Call ? Int) 1)
