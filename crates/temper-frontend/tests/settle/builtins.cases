=== builtin generic methods' own type parameters are solved per call
// `map<O>`, `reduceFrom<O>`, `reduceFromIndex<O>` and `Mapped`'s
// `toListWith<T>`, from their arguments and the type wanted, with the
// receiver shown as the declaring type sees it (`Listed<Int32>`). Kotlin
// also binds `O` to `String` where `0` and `addS` bind it two ways (b3),
// solves from the type wanted where only variance tells `Animal` and `Dog`
// apart (c3), and first (d1, `fn (Int32): String`, not `AnyValue`); and
// types function literal arguments (d3). Explicit type arguments bind as
// written (d4), where Kotlin fails, as for users' methods.
class Animal {}
class Dog extends Animal {}
let toStr(x: Int): String { x.toString() }
let addS(a: String, x: Int): String { a }
let addI(a: Int, x: Int): Int { a }
let kv(k: String, v: Int): String { k }
let anim(x: Int): Animal { new Animal() }
let f(ls: List<Int>, lb: ListBuilder<Int>, ld: Listed<Int>, m: Map<String, Int>, mb: MapBuilder<String, Int>): Void {
  let a1: List<Int> = ls.map(toStr);
  let a2: Int = ls.map(toStr);
  let a3 = ls.map(toStr);
  let a4: List<Int> = a3;
  let a5: Int = lb.map(toStr);
  let a6: Listed<Int> = ld.map(toStr);
  let b1: String = ls.reduceFrom(0, addI);
  let b2: Int = ls.reduceFrom("", addS);
  let b3: Int = ls.reduceFrom(0, addS);
  let b4: Int = ls.reduceFromIndex("", 1, addS);
  let c1: List<Int> = m.toListWith(kv);
  let c2: Int = mb.toListBuilderWith(kv);
  let c3: List<Dog> = ls.map(anim);
  ls.map(1);
  ls.map(toStr, 2);
  let d1: List<String> = ls.map(addS);
  let d2: String = ls.reduceFrom(0, fn (a: Int, x: Int): Int { a });
  let d3: Int = ls.map(fn (x: Int): String { "" });
  let d4: List<String> = ls.map<String>(toStr);
}
