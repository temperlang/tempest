=== operators unchecked where types aren't known as Kotlin knows them
class C {}
let a1(c: C): Int { c + 1 }
let a2(f: fn (): Int): Int { 1 + f }
let a3(x: AnyValue): Int { x * 2 }
let a4(x: Int): Int { x + panic() }
let a5(x: Int, y: Int?): Boolean { x == y }
let a6(x: Int, y: String?): Boolean { x == y }
let c: Int? = 1;
let a7(): Int { c + 1 }
let a8(x: String): String { var y = x; y++; y }
let a9(x: Int): Boolean { x == null }
