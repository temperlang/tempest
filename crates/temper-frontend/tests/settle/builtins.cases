  (Let ^a9:10 (Fn (Let ^x:23 Int) Boolean (Block (Call == x:23 null)))))

=== what may bubble where it can't
let g(x: Int): Int throws Bubble { if (x == 0) { bubble() } else { x } }
let a1(x: Int): Int { if (x < 0) { bubble() } else { x } }
let a2(): Int { return bubble(); }
let a3(x: Int): Int { g(x) }
let a4(h: fn (Int): Int throws Bubble): Int { h(1) }
let a5(x: Int): Int { let k = g; k(x) }
let a6(a: Int, b: Int): Int { a / b }
let a7(a: Int): Int { a / 0 }
let a8(a: Int): Int { a % -3 }
let a9(a: Float64): Float64 { a / 2.0 }
let b1(a: Int): Void { a % a; }
let b2(a: Int): Void { console.log("${a / a}") }
let b3(a: Int): Int { if (a / a == 1) { 1 } else { 0 } }
let b4(a: Int): Int { do { let f(): Int { a / a }; f() } orelse 0 }
let b5(a: Int): Int { do { a / a } orelse bubble() }
let b6(a: Int): Void { for (let x of [1]) { console.log("${x / a}"); } }
let b7(a: Int): Int { let f = fn (): Int { a / a }; f() }
let b8(a: Int): Int { let f(y: Int = a / a): Int { y }; f() }
let b9(a: Int): Int { if (true) { a / a } else { 0 } }
class D {
  private var q: Int = 0;
  public constructor(a: Int) { q = a / a; }
  public m(a: Int): Int { a % a }
  public get p(): Int { q / q }
  public set p(v: Int): Void { q = v / v; }
}
