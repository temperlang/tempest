=== builtins with one signature
let a1(): Boolean { !"a" }
let a2(x: Boolean?): Boolean { !x }
let a3(): Boolean { !null }
let a4(): Int { 2 ** 3 }
let a5(): Float64 { null ** 1.0 }
let a6(x: Int): Void { console.log(x) }
let a7(s: String?): Void { console.log(s) }
let a8(): Void { console.log() }
let a9(x: Int): Void { console.log(x, x) }
console.log("ok");
--- settled
(Block
  (Let ^a1:0 (Fn Boolean (Block (Call ! "a"))))
  (Let ^a2:1 (Fn (Let ^x:9 (Call ? Boolean)) Boolean (Block (Call ! x:9))))
  (Let ^a3:2 (Fn Boolean (Block (Call ! null))))
  (Let ^a4:3 (Fn Int (Block (Call ** 2 3))))
  (Let ^a5:4 (Fn Float64 (Block (Call ** null 1.0))))
  (Let
    ^a6:5
    (Fn (Let ^x:10 Int) Void (Block (Call (Call . console \log) x:10))))
  (Let
    ^a7:6
    (Fn
      (Let ^s:11 (Call ? String))
      Void
      (Block (Call (Call . console \log) s:11))))
  (Let ^a8:7 (Fn Void (Block (Call (Call . console \log)))))
  (Let
    ^a9:8
    (Fn (Let ^x:12 Int) Void (Block (Call (Call . console \log) x:12 x:12))))
  (Call (Call . console \log) "ok")
  #void)
