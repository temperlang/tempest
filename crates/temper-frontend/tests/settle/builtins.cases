=== what may bubble in operators' arguments
// Kotlin doesn't look into an operator's arguments that don't fit the
// variant it picks, unless the first fits no variant; with one
// signature, only into those that fit.
class K {}
class H {
  @operator("==")
  public eq(other: H): Boolean { true }
}
let mi(n: Int): Int throws Bubble { if (n > 0) { 1 } else { bubble() } }
let mf(n: Int): Float64 throws Bubble { if (n > 0) { 1.0 } else { bubble() } }
let mk(n: Int): K throws Bubble { if (n > 0) { new K() } else { bubble() } }
let a1(n: Int): Int { "a" - mi(n) }
let a2(n: Int): Boolean { "a" == mi(n) }
let a3(k: K, n: Int): Boolean { k == mi(n) }
let a4(k: K, n: Int): Boolean { mk(n) == k }
let a5(n: Int): Int { mi(n) - "a" }
let a6(n: Int): Boolean { 1 == mk(n) }
let a7(h: H, n: Int): Boolean { h == mk(n) }
let b1(n: Int): Float64 { mf(n) ** "a" }
let b2(n: Int): Float64 { "a" ** mf(n) }
let b3(n: Int): Boolean { !mi(n) }
let b4(n: Int): Float64 { mi(n) ** mf(n) }
