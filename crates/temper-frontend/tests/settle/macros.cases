=== early return
let f(n: Int): String {
  if (n > 0) { return "positive"; }
  "not"
}
console.log(f(1));
console.log(f(0));
--- settled
(Block
  (Let
    ^f:0
    (Fn
      (Let ^n:1 Int)
      String
      (Block
        (If (Call > n:1 0) (Block (Return @0 "positive") #void) (Block))
        "not")))
  (Call (Call . console \log) (Call f:0 1))
  (Call (Call . console \log) (Call f:0 0))
  #void)
log positive
log not

=== orelse and bubble
let check(n: Int): Int { if (n < 0) { bubble() } else { n } }
console.log((check(1) orelse -1).toString());
console.log((check(-1) orelse -1).toString());
--- settled
(Block
  (Let
    ^check:0
    (Fn
      (Let ^n:1 Int)
      Int
      (Block (If (Call < n:1 0) (Block (Fail)) (Block n:1)))))
  (Call
    (Call . console \log)
    (Call (Call . (Orelse (Call check:0 1) (Call - 1)) \toString)))
  (Call
    (Call . console \log)
    (Call (Call . (Orelse (Call check:0 (Call - 1)) (Call - 1)) \toString)))
  #void)
log 1
log -1

=== logical operators short-circuit
let loud(b: Boolean): Boolean { console.log(b.toString()); b }
console.log((loud(false) && loud(true)).toString());
console.log((loud(true) || loud(false)).toString());
--- settled
(Block
  (Let
    ^loud:0
    (Fn
      (Let ^b:1 Boolean)
      Boolean
      (Block (Call (Call . console \log) (Call (Call . b:1 \toString))) b:1)))
  (Call
    (Call . console \log)
    (Call (Call . (If (Call loud:0 false) (Call loud:0 true) #false) \toString)))
  (Call
    (Call . console \log)
    (Call (Call . (If (Call loud:0 true) #true (Call loud:0 false)) \toString)))
  #void)
log false
log false
log true
log true

=== increments and compound assignment
do {
  var n = 5;
  console.log((n++).toString());
  console.log((++n).toString());
  n -= 2;
  n *= 3;
  console.log(n.toString());
}
--- settled
(Block
  (Block
    (Var ^n:0 5)
    (Call
      (Call . console \log)
      (Call
        (Call
          .
          (Block (Let ^t#1 n:0) (Assign n:0 (Call + t#1 1)) t#1)
          \toString)))
    (Call
      (Call . console \log)
      (Call (Call . (Assign n:0 (Call + n:0 1)) \toString)))
    (Assign n:0 (Call - n:0 2))
    (Assign n:0 (Call * n:0 3))
    (Call (Call . console \log) (Call (Call . n:0 \toString)))
    #void))
log 5
log 7
log 15

=== string interpolation
let name = "World";
let n = 3;
console.log("Hello, ${name}! ${n + 1} ${true}");
--- settled
(Block
  (Let ^name:0 "World")
  (Let ^n:1 3)
  (Call
    (Call . console \log)
    (Call cat "Hello, " name:0 "! " (Call + n:1 1) " " true))
  #void)
log Hello, World! 4 true

=== block arguments with parameters
let twice(x: Int, f: fn (Int): Int): Int { f(f(x)) }
console.log(twice(2) { (y: Int): Int => y * 3 }.toString());
console.log(twice(2, fn (y: Int): Int { y + 1 }).toString());
--- settled
(Block
  (Let
    ^twice:0
    (Fn
      (Let ^x:1 Int)
      (Let ^f:2 (Call FnType Int Int))
      Int
      (Block (Call f:2 (Call f:2 x:1)))))
  (Call
    (Call . console \log)
    (Call
      (Call
        .
        (Call twice:0 2 (Fn (Let ^y:3 Int) Int (Block (Call * y:3 3))))
        \toString)))
  (Call
    (Call . console \log)
    (Call
      (Call
        .
        (Call twice:0 2 (Fn (Let ^y:4 Int) Int (Block (Call + y:4 1))))
        \toString)))
  #void)
log 18
log 4

=== comments and doc comments go away
/** Doc. */
let f(
  /** The input. */
  x: Int
): Int {
  // A comment.
  x
}
console.log(f(1).toString());
--- settled
(Block
  (Let ^f:0 (Fn (Let ^x:1 Int) Int (Block x:1)))
  (Call (Call . console \log) (Call (Call . (Call f:0 1) \toString)))
  #void)
log 1

=== malformed uses of macros
if (true);
while (true);
let;
--- settled
(Block (Error) (Error) (Error) #void)
error 0..9: Use of builtin if is malformed
error 11..23: Use of builtin while is malformed
error 25..28: Use of builtin let is malformed
Failed: Use of builtin if is malformed

=== type parameters, scoped around their class or function, erased at run time
interface I<T> { get(): T; }
class C<@imu T, U extends I<U>>(public x: T) extends I<T> {
  public get(): T { x }
  public pick<V>(v: V): V { v }
}
let f<T>(x: T): T { x }
let c = new C<Int, I<Int>>(1);
console.log("${f<String>("a")} ${c.pick<Int>(2)} ${c is C<Int, I<Int>>}");
--- settled
(Block
  (Interface ^I:0 (TypeParam ^T:4) (Method ^get:6 T:4))
  (Class
    ^C:1
    (TypeParam ^T:7)
    (TypeParam ^U:8 (Call <> I:0 U:8))
    (Call <> I:0 T:7)
    (Param ^x:10 T:7)
    (Method ^get:11 (Fn T:7 (Block x:10)))
    (Method ^pick:12 (Fn (TypeParam ^V:13) (Let ^v:14 V:13) V:13 (Block v:14))))
  (Let ^f:2 (Fn (TypeParam ^T:15) (Let ^x:16 T:15) T:15 (Block x:16)))
  (Let ^c:3 (Call new (Call <> C:1 Int (Call <> I:0 Int)) 1))
  (Call
    (Call . console \log)
    (Call
      cat
      (Call f:2 \typeArg String "a")
      " "
      (Call (Call . c:3 \pick) \typeArg Int 2)
      " "
      (Call is c:3 (Call <> C:1 Int (Call <> I:0 Int)))))
  #void)
log a 2 true

=== class members
interface Greeter {
  public greet(): Void;
  public get name(): String;
}
class C(
  public var x: String,
  private var y: Int = 1,
) extends Greeter {
  public var z: Int = 2;
  private helper(i: Int): Int { i + y }
  public greet(): Void { this.z = helper(z); }
  public get name(): String { x }
  public set name(v: String): Void { x = v }
}
let c = new C("Hello");
c.greet();
--- settled
(Block
  (Interface ^Greeter:0 (Method ^greet:4 Void) (Get ^name:5 String))
  (Class
    ^C:1
    Greeter:0
    (Param var ^x:7 String)
    (Param var private ^y:8 Int 1)
    (Var ^z:9 Int 2)
    (Method private
      ^helper:10
      (Fn (Let ^i:14 Int) Int (Block (Call + i:14 y:8))))
    (Method
      ^greet:11
      (Fn Void (Block (Assign (Call . this#6 \z) (Call helper:10 z:9)) #void)))
    (Get ^name:12 (Fn String (Block x:7)))
    (Set ^name:13 (Fn (Let ^v:15 String) Void (Block (Assign x:7 v:15)))))
  (Let ^c:2 (Call new C:1 "Hello"))
  (Call (Call . c:2 \greet))
  #void)

=== destructuring let, as Kotlin's flattenMultiInit
class C(public a: Int, public b: String) {}
let { a, b as c is String } = new C(1, "two");
let { e } = Float64;
console.log("${a} ${c} ${e}");
let { x as y as z } = 1;
let { f, ... } = 1;
--- settled
(Block
  (Class ^C:0 (Param ^a:6 Int) (Param ^b:7 String))
  (Let ^destructured#1 (Call new C:0 1 "two"))
  (Let ^a:2 (Call . destructured#1 \a))
  (Let ^c:3 String (Call . destructured#1 \b))
  (Let ^e:4 (Call . Float64 \e))
  (Call (Call . console \log) (Call cat a:2 " " c:3 " " e:4))
  (Error)
  (Error)
  #void)
error 143..166: Declaration is malformed
error 168..186: Declaration is malformed
log 1 two 2.718281828459045
Failed: Declaration is malformed

=== several declarations in one, as Kotlin's flattenMultiDeclarations
@export var i: Int = 0, end: Int;
end = 3;
for (var j = 0, k = 2; j < k; ++j) { console.log("${i} ${end} ${j}"); }
--- settled
(Block
  (Var ^i:0 Int 0)
  (Var ^end:1 Int)
  (Assign end:1 3)
  (Block
    (Var ^j:2 0)
    (Var ^k:3 2)
    (Loop
      (If
        (Call < j:2 k:3)
        (Block
          (Call (Call . console \log) (Call cat i:0 " " end:1 " " j:2))
          #void)
        (Break @43))
      (Assign j:2 (Call + j:2 1)))))
log 0 3 0
log 0 3 1
