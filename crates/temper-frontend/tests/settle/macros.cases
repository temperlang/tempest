=== type parameters, scoped around their class or function, erased at run time
interface I<T> { get(): T; }
class C<@imu T, U extends I<U>>(public x: T) extends I<T> {
  public get(): T { x }
  public pick<V>(v: V): V { v }
}
let f<T>(x: T): T { x }
let c = new C<Int, I<Int>>(1);
console.log("${f<String>("a")} ${c.pick<Int>(2)} ${c is C<Int, I<Int>>}");
--- settled
(Block
  (Interface ^I:0 (TypeParam ^T:4) (Method ^get:6 (Signature T:4)))
  (Class
    ^C:1
    (TypeParam ^T:7)
    (TypeParam ^U:8 (Call <> I:0 U:8))
    (Call <> I:0 T:7)
    (Param ^x:10 T:7)
    (Method ^get:11 (Fn T:7 (Block x:10)))
    (Method ^pick:12 (Fn (TypeParam ^V:13) (Let ^v:14 V:13) V:13 (Block v:14))))
  (Let ^f:2 (Fn (TypeParam ^T:15) (Let ^x:16 T:15) T:15 (Block x:16)))
  (Let ^c:3 (Call new (Call <> C:1 Int (Call <> I:0 Int)) 1))
  (Call
    (Call . console \log)
    (Call
      cat
      (Call f:2 \typeArg String "a")
      " "
      (Call (Call . c:3 \pick) \typeArg Int 2)
      " "
      (Call is c:3 (Call <> C:1 Int (Call <> I:0 Int)))))
  #void)
info 253..272: Unnecessary type check to C<Int32, I<Int32>> from expression with type C<Int32, I<Int32>> which is a subtype
log a 2 true

=== class members
interface Greeter {
  public greet(): Void;
  public get name(): String;
}
class C(
  public var x: String,
  private var y: Int = 1,
) extends Greeter {
  public var z: Int = 2;
  private helper(i: Int): Int { i + y }
  public greet(): Void { this.z = helper(z); }
  public get name(): String { x }
  public set name(v: String): Void { x = v }
}
let c = new C("Hello");
c.greet();
--- settled
(Block
  (Interface
    ^Greeter:0
    (Method ^greet:4 (Signature Void))
    (Get ^name:5 (Signature String)))
  (Class
    ^C:1
    Greeter:0
    (Param var ^x:7 String)
    (Param var private ^y:8 Int 1)
    (Var ^z:9 Int 2)
    (Method private
      ^helper:10
      (Fn (Let ^i:14 Int) Int (Block (Call + i:14 y:8))))
    (Method
      ^greet:11
      (Fn Void (Block (Assign (Call . this#6 \z) (Call helper:10 z:9)) #void)))
    (Get ^name:12 (Fn String (Block x:7)))
    (Set ^name:13 (Fn (Let ^v:15 String) Void (Block (Assign x:7 v:15)))))
  (Let ^c:2 (Call new C:1 "Hello"))
  (Call (Call . c:2 \greet))
  #void)

=== destructuring let, as Kotlin's flattenMultiInit
class C(public a: Int, public b: String) {}
let { a, b as c is String } = new C(1, "two");
let { e } = Float64;
console.log("${a} ${c} ${e}");
let { x as y as z } = 1;
let { f, ... } = 1;
--- settled
(Block
  (Class ^C:0 (Param ^a:10 Int) (Param ^b:11 String))
