  (Class
    ^Counted:0
    (Var private ^n:4 Int 0)
    (Method
      ^append:5
      (Fn (Let ^i:8 Int) Void (Block (Assign n:4 (Call + n:4 i:8)) #void)))
    (Method
      ^appendSafe:6
      (Fn
        (Let ^s:9 String)
        Void
        (Block (Call (Call . console \log) (Call cat "safe " s:9)) #void)))
    (Get ^accumulated:7 (Fn Int (Block n:4))))
  (Let ^counted:1 Counted:0)
  (Call
    (Call . console \log)
    (Call
      cat
      (Block
        (Let ^accumulator#10 (Call new Counted:0))
        (Block
          (Call (Call . accumulator#10 \appendSafe) "a")
          (Call (Call . accumulator#10 \append) 6)
          (Call (Call . accumulator#10 \appendSafe) ", ")
          (Call (Call . accumulator#10 \append) 7)
          (Call (Call . accumulator#10 \appendSafe) "\\n"))
        (Call . accumulator#10 \accumulated))))
  (Call
    (Call . console \log)
    (Call
      cat
      (Block
        (Let ^accumulator#11 (Call new counted:1))
        (Block
          (Call (Call . accumulator#11 \appendSafe) "Zero: ")
          (Call (Call . accumulator#11 \append) 0)
          (Call (Call . accumulator#11 \appendSafe) "\n")
          (Loop
            (Block
              (Call
                (Call . (Call list 2 3) \forEach)
                (Fn
                  (Let ^n:12)
                  (Block
                    (Call (Call . accumulator#11 \appendSafe) " ")
                    (Call (Call . accumulator#11 \append) n:12)
                    #void)))
