=== do … while: the body runs before the check, and continue goes to the check
var i = 1;
do {
  console.log("Done ${i}");
} while (i-- >= 0);
do {
  console.log("Done once");
  continue;
  console.log("Not done");
} while (false);
var n = 0;
outer: do {
  n += 1;
  do {
    if (n == 2) { continue outer; }
    if (n == 4) { break outer; }
    console.log("n ${n}");
  } while (false);
} while (true);
let v = do { 1 } while (false);
console.log("${v}");
--- settled
(Block
  (Var ^i:0 1)
  (Loop
    (Block (Call (Call . console \log) (Call cat "Done " i:0)) #void)
    (If
      (Call >= (Block (Let ^t#3 i:0) (Assign i:0 (Call - t#3 1)) t#3) 0)
      (Block)
      (Break @11)))
  (Loop
    (Block
      (Call (Call . console \log) "Done once")
      (Continue @64)
      (Call (Call . console \log) "Not done")
      #void)
    (If false (Block) (Break @64)))
  (Var ^n:1 0)
  (Block
    (Loop
      (Block
        (Assign n:1 (Call + n:1 1))
        (Loop
          (Block
            (If (Call == n:1 2) (Block (Continue @171) #void) (Block))
            (If (Call == n:1 4) (Block (Break @164) #void) (Block))
            (Call (Call . console \log) (Call cat "n " n:1))
            #void)
          (If false (Block) (Break @188)))
        #void)
      (If true (Block) (Break @171))))
  (Let ^v:2 (Loop (Block 1) (If false (Block) (Break @332))))
  (Call (Call . console \log) (Call cat v:2))
  #void)
