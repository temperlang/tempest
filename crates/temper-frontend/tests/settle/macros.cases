=== decorated destructuring, each declaration decorated, as Kotlin's flattenMultiInit then flattenMultiDeclarations
class C(public a: Int, public b: String) {}
@var let { a, b as c } = new C(1, "two");
a += 1;
let f(x: C): Void {
  @var let { b } = x;
  b = "${b}!";
  console.log("${a} ${c} ${b}");
}
f(new C(3, "four"));
// Not destructuring, but `var` called with a block.
var { a as d } = new C(5, "six");
--- settled
(Block
  (Class ^C:0 (Param ^a:6 Int) (Param ^b:7 String))
  (Var ^destructured#1 (Call new C:0 1 "two"))
  (Var ^a:2 (Call . destructured#1 \a))
  (Var ^c:3 (Call . destructured#1 \b))
  (Assign a:2 (Call + a:2 1))
  (Let
    ^f:4
    (Fn
      (Let ^x:8 C:0)
      Void
      (Block
        (Var ^b:9 (Call . x:8 \b))
        (Assign b:9 (Call cat b:9 "!"))
        (Call (Call . console \log) (Call cat a:2 " " c:3 " " b:9))
        #void)))
  (Call f:4 (Call new C:0 3 "four"))
  (Error)
  #void)
