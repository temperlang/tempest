# Macro expansion into core constructs: input, then the settled tree and
# diagnostics as print::write_settled writes them, then what running it
# logs.
=== if, else if and else
let sign(n: Int): String {
  if (n < 0) { "negative" } else if (n == 0) { "zero" } else { "positive" }
}
console.log(sign(-5));
console.log(sign(0));
console.log(sign(5));
--- settled
(Block
  (Let
    ^sign:0
    (Fn
      (Let ^n:1 Int)
      String
      (Block
        (If
          (Call < n:1 0)
          (Block "negative")
          (If (Call == n:1 0) (Block "zero") (Block "positive"))))))
  (Call (Call . console \log) (Call sign:0 (Call - 5)))
  (Call (Call . console \log) (Call sign:0 0))
  (Call (Call . console \log) (Call sign:0 5))
  #void)
log negative
log zero
log positive

=== if without else is void
let x = if (false) { 1 };
--- settled
(Block (Let ^x:0 (If false (Block 1) (Block))) #void)

=== while, with continue and break
var i = 0;
while (true) {
  i += 1;
  if (i == 2) { continue; }
  if (i > 3) { break; }
  console.log(i.toString());
}
--- settled
(Block
  (Var ^i:0 0)
  (Loop
    (If
      true
      (Block
        (Assign i:0 (Call + i:0 1))
        (If (Call == i:0 2) (Block (Continue @11) #void) (Block))
        (If (Call > i:0 3) (Block (Break @11) #void) (Block))
        (Call (Call . console \log) (Call (Call . i:0 \toString)))
        #void)
      (Break @11))))
log 1
log 3

=== for, with labels
outer: for (var i = 0; i < 3; i++) {
  for (var j = 0; j < 3; j++) {
    if (j == 1) { continue outer; }
    if (i == 2) { break outer; }
    console.log("${i} ${j}");
  }
}
--- settled
(Block
  (Block
    (Block
      (Var ^i:0 0)
      (Loop
        (If
          (Call < i:0 3)
          (Block
            (Block
              (Var ^j:2 0)
              (Loop
                (If
                  (Call < j:2 3)
                  (Block
                    (If (Call == j:2 1) (Block (Continue @7) #void) (Block))
                    (If (Call == i:0 2) (Block (Break @0) #void) (Block))
                    (Call (Call . console \log) (Call cat i:0 " " j:2))
                    #void)
                  (Break @39))
                (Block (Let ^t#3 j:2) (Assign j:2 (Call + t#3 1)) t#3))))
          (Break @7))
        (Block (Let ^t#1 i:0) (Assign i:0 (Call + t#1 1)) t#1)))))
log 0 0
log 1 0

