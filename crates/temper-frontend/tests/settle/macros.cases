  (Let ^e:4 (Call . Float64 \e))
  (Call (Call . console \log) (Call cat a:2 " " c:3 " " e:4))
  (Let ^destructured#5 1)
  (Let ^y:6 (Call . destructured#5 \x))
  (Let ^destructured#7 1)
  (Let ^f:8 (Call . destructured#7 \f))
