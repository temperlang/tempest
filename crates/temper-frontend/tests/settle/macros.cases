=== block arguments with parameters
let twice(x: Int, f: fn (Int): Int): Int { f(f(x)) }
console.log(twice(2) { (y: Int): Int => y * 3 }.toString());
console.log(twice(2, fn (y: Int): Int { y + 1 }).toString());
