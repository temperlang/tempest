=== a tag that names a class is an accumulator type
class Counted {
  private var n: Int = 0;
  public append(i: Int): Void { n += i; }
  public appendSafe(s: String): Void { console.log("safe ${s}"); }
  public get accumulated(): Int { n }
}
let counted = Counted;
console.log("${Counted"a${6}, ${7}\n"}");
console.log("${counted"""
  "Zero: ${0}
  : for (let n of [2, 3]) {
    ~ ${n}
  : }
  ~F\our: ${5}
  }");
let tag(parts: List<String>, values: List<Int>): String {
  parts.join("|", fn (s: String): String { s })
}
console.log(tag"a${1}b");
console.log(tag"""
  : if (true) {
  ~a${1}b
  : }
  );
--- settled
