=== private and static members outside their class are errors, as Kotlin's typer reports them
class Private(private b: Int) {
  public sharing(other: Private): Int { b + other.b }
  private static hidden: Int = 1;
  public static shown: Int = Private.hidden + 1;
}
let aPrivate = new Private(9);
console.log(aPrivate.sharing(aPrivate).toString());
console.log(Private.shown.toString());
class Outsider {
  public burgle(victim: Private): Int { victim.b }
  public static peek(): Int { Private.hidden }
}
console.log(Private.nope.toString());
console.log(aPrivate.b.toString());
--- settled
(Block
  (Class
    ^Private:0
    (Param private ^b:4 Int)
    (Method
      ^sharing:5
      (Fn (Let ^other:8 Private:0) Int (Block (Call + b:4 (Call . other:8 \b)))))
    (Let private static ^hidden:6 Int 1)
    (Let static ^shown:7 Int (Call + (Call . Private:0 \hidden) 1)))
  (Let ^aPrivate:1 (Call new Private:0 9))
  (Call
    (Call . console \log)
    (Call (Call . (Call (Call . aPrivate:1 \sharing) aPrivate:1) \toString)))
  (Call
    (Call . console \log)
    (Call (Call . (Call . Private:0 \shown) \toString)))
  (Class
    ^Outsider:2
    (Method
      ^burgle:10
      (Fn (Let ^victim:12 Private:0) Int (Block (Call . victim:12 \b))))
    (Method static ^peek:11 (Fn Int (Block (Call . Private:0 \hidden)))))
  (Call
    (Call . console \log)
    (Call (Call . (Call . Private:0 \nope) \toString)))
  (Call (Call . console \log) (Call (Call . (Call . aPrivate:1 \b) \toString)))
  #void)
