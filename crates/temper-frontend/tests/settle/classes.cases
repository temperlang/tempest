=== private members aren't usable outside their class
class C(private x: Int) { private twice(): Int { x * 2 } }
interface I { public peek(c: C): Int { c.twice() } }
class D extends I {}
console.log(new D().peek(new C(3)).toString());
--- settled
(Block
