            (Call . console \log)
            (Call cat "Assigned " (Call (Call . newValue:5 \toString) 10)))
          #void))))
  (Let ^c:1 (Call new C:0))
  (Assign (Call . c:1 \p) (Assign (Call . c:1 \p) 123))
  (Assign (Call . c:1 \p) 5)
  (Let
    ^wrong:2
    (Fn
      Void
      (Block
        (Assign (Call . c:1 \p) "x")
        (Call (Call . console \log) (Call (Call . (Call . c:1 \p) \toString)))
        #void))))
