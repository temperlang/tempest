=== constructors beside header parameters or initializers, as Kotlin's constructors-and-property-initialization
// OK: the implied constructor sets k.
class NeedsConstructor(
  @noProperty i: Int32,
  public j: Int32 = 1,
) {
  public k: Int32 = i + 1;
}
// OK: one constructor runs the initializer.
class HasConstructorAndInitializedProperty {
  private var b: Boolean = false;
  private let i: Int32;
  public constructor(i: Int32) {
    this.i = i;
  }
  public f(): Int32 {
    b = !b;
    i + (if (b) { 1 } else { 0 })
  }
}
// Each would need a copy of the initializer; a static one's fine.
class HasTooManyConstructors {
  private var b: Boolean = false;
  public static s: Int = 1;
  public constructor() {}
  public constructor(c: Boolean) {
    if (c) { this.b = !this.b; }
  }
}
// Header parameters don't fold into an explicit constructor.
class HasConstructorAndParenthesizedArguments(
  public s: String,
  @noProperty t: String,
) {
  public constructor() {}
}
console.log("${new NeedsConstructor(1).k} ${new HasConstructorAndInitializedProperty(2).f()}");
