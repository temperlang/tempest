=== exports that expose what isn't exported, as Kotlin Temper's ExportChecker reports them
interface Hidden {}
export class Exported<HI extends Hidden>(public hi: Hidden) extends Hidden {
  public attempt(): Hidden { hi }
  public attempt2<H extends Hidden>(hmm: H): H { hmm }
  public static subvert(): Map<String, Hidden> { more }
  // This one should be fine, unlike all the others.
  private ha: Hidden = hi;
}
export let consider(hu: Hidden): Hidden? { hu }
export let sneak<H extends Hidden>(he: H): H { he }
export let more = new Map<String, Hidden>([]);
class Fine {}
export let callback(f: fn (Fine): Void): Void {}
// A private header property is the implied constructor's parameter.
export class Holder(private held: Fine) {}
export class Made {
  public constructor(other: Hidden) {}
}
// Not exports, nor private members, nor another module's types.
let local(h: Hidden): Hidden { h }
export class Open {
