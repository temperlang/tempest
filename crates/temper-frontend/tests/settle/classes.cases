=== connected functions that list backends need a body, as Kotlin's connected-backends
// Fine: backends not listed use the body.
@connected(["cpp", "rust"])
export let withBody(i: Int): Int { i + 1 }
// Fine: no list means every backend has connected code.
@connected
export let everywhere(i: Int): Int;
// Fine: an empty list names none, so all use the body.
@connected([])
export let nowhere(i: Int): Int { i + 3 }
// Backends not listed would have no body to use.
@connected(["cpp"])
export let noBody(i: Int): Int;
// Not a list of backend names: connected as if without a list.
@connected("cpp")
export let notAList(i: Int): Int { i + 2 }
@connected(["cpp", 1])
export let notNames(i: Int): Int { i + 4 }
console.log("${withBody(1)} ${nowhere(1)} ${notAList(1)}");
