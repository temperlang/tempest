=== a connected class's Temper implementation must be complete
@connected
export class Whole {
  private var n: Int = 0;
  public bump(): Int { n += 1; n }
}
@connected(["cpp", "rust"])
export class Listed {
  public twice(i: Int): Int { i * 2 }
}
@connected
export class Bodiless(public x: Int) {
  public three(): Int;
}
@connected
export class Partial {
  public one(): Int { 1 }
  public two(): Int;
}
@connected(["cpp"])
export class Unlisted {
  public four(): Int;
}
@connected
export class Defaulted {
  public scale(x: Int, by: Int = 1): Int { x * by }
}
console.log("${new Whole().bump()} ${new Listed().twice(2)} ${new Defaulted().scale(3)}");
--- settled
(Block
  (Class
    ^Whole:0
    (Var private ^n:7 Int 0)
    (Method ^bump:8 (Fn Int (Block (Assign n:7 (Call + n:7 1)) n:7))))
  (Class
    ^Listed:1
    (Method ^twice:10 (Fn (Let ^i:11 Int) Int (Block (Call * i:11 2)))))
  (Class ^Bodiless:2 (Param ^x:13 Int) (Method ^three:14 (Signature Int)))
  (Class
    ^Partial:3
    (Method ^one:16 (Fn Int (Block 1)))
    (Method ^two:17 (Signature Int)))
  (Class ^Unlisted:4 (Method ^four:19 (Signature Int)))
  (Class
    ^Defaulted:5
    (Method
      ^scale:21
      (Fn (Let ^x:22 Int) (Let ^by:23 Int 1) Int (Block (Call * x:22 by:23)))))
  (Call
    (Call . console \log)
    (Call
      cat
      (Call (Call . (Call new Whole:0) \bump))
      " "
      (Call (Call . (Call new Listed:1) \twice) 2)
      " "
      (Call (Call . (Call new Defaulted:5) \scale) 3)))
  #void)
error 329..332: Method two of a @connected class needs a Temper body, since other methods have one, and a Temper fallback must be complete
error 396..400: Method four of a @connected class that lists backends needs a Temper body for the backends not listed
error 456..461: Method scale of a connected class can't have default arguments, since host code implements it directly
