=== private members are readable on any instance of their class
class C(private var x: Int) {
  private static secret = 7;
  private twice(): Int { x * 2 }
  public plus(o: C): Int { o.x + x + o.twice() + C.secret }
  public set(o: C): Void { o.x = 10; }
}
let a = new C(1);
let b = new C(2);
console.log(a.plus(b).toString());
a.set(b);
console.log(a.plus(b).toString());
console.log(C.secret.toString());
--- settled
(Block
  (Class
    ^C:0
    (Param var private ^x:4 Int)
    (Let private static ^secret:5 7)
    (Method private ^twice:6 (Fn Int (Block (Call * x:4 2))))
    (Method
      ^plus:7
      (Fn
        (Let ^o:9 C:0)
        Int
        (Block
          (Call
            +
            (Call + (Call + (Call . o:9 \x) x:4) (Call (Call . o:9 \twice)))
            (Call . C:0 \secret)))))
    (Method
      ^set:8
      (Fn (Let ^o:10 C:0) Void (Block (Assign (Call . o:10 \x) 10) #void))))
  (Let ^a:1 (Call new C:0 1))
  (Let ^b:2 (Call new C:0 2))
  (Call
    (Call . console \log)
    (Call (Call . (Call (Call . a:1 \plus) b:2) \toString)))
  (Call (Call . a:1 \set) b:2)
  (Call
    (Call . console \log)
    (Call (Call . (Call (Call . a:1 \plus) b:2) \toString)))
  (Call (Call . console \log) (Call (Call . (Call . C:0 \secret) \toString)))
  #void)
error 321..329: Member secret defined in C not publicly accessible
