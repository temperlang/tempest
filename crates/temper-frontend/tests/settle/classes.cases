=== static getters and setters are rejected, as Kotlin's static-getters-and-setters-rejected
// Nothing would read `C.answer` with them, so they're dropped.
class C {
  public static get answer(): Int { 42 }
  public static set count(v: Int): Void {}
  public get age(): Int { 1 }
  public static twice(x: Int): Int { x * 2 }
}
console.log("${C.twice(2)} ${new C().age}");
