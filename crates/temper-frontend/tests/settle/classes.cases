=== static members can't be assigned, even a `var`, as Kotlin reports
class C {
  public static var count: Int = 0;
  public bump(): Void { C.count += 1; C.count++; }
  public static reset(): Void { C.count = 0; count = 1; }
}
let set(): Void { C.count = 2; C.count--; }
console.log("before ${C.count}");
new C().bump();
console.log("after ${C.count}");
