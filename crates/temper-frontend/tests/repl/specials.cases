=== the module includes earlier inputs that change what it uses
var v = 1
v = 2;
let lb = new ListBuilder<Int>();
lb.add(3);
let unrelated = new ListBuilder<Int>();
unrelated.add(4);
if (v > 1) { lb.add(v); }
lb.toList()
describe(7, "module")
describe(1, "module")
