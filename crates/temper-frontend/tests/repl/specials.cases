=== the module drops an import repeated, rather than renaming it
let { Date } = import("std/temporal")
let d1 = new Date(2020, 1, 2)
let { Date } = import("std/temporal")
let d2(): Date { new Date(2021, 3, 4) }
"${d2().toString()} ${d1.toString()}"
describe(4, "module")
let { CodePoints } = import("std/regex")
let cp = new CodePoints("a")
let { Capture, CodePoints } = import("std/regex")
"${new Capture("x", new CodePoints("b")).name}${cp.value}"
describe(9, "module")
class Date(public x: Int) {}
let { Date } = import("std/temporal")
new Date(2022, 5, 6).toString()
describe(13, "module")
