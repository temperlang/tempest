# REPL sessions: the REPL's own functions, without the tools that
# hover's text, tmpl, and the backends need (temper-driver's tests
# cover those).
=== describe shows an input at tempest's steps
let x = 1
let twice(n: Int): Int { n * 2 }
twice(x) + 1
describe(2, "parsed")
describe(2)
describe(1, "types")
describe(2, "types")
describe(2, "module")
describe(9, "parsed")
describe(0, "nope")
--- transcript
interactive#0: void
interactive#1: void
interactive#2: 3
(Call #desugarOperation + (Call twice x) 1)
interactive#3: void
(Block (Call + (Call twice:10 x:9) 1))
interactive#4: void
twice: fn (Int32): Int32
interactive#5: void
result: Int32
interactive#6: void
// interactive#0
let x = 1;
// interactive#1
let twice(n: Int): Int { n * 2 };
// interactive#2
twice(x) + 1;
interactive#7: void
Failed: describe: there's no input 9; they're 0 to 8
