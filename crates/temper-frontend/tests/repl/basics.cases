# REPL sessions, each case one: what's typed or piped in, a line at a
# time, then what the session prints. Basics: results, inputs that span
# lines, and names across inputs, after Kotlin's ReplTest.
=== results
1 + 2
1 + 2;
"a\"b"
[1, 2, 3].map { x => x * 2 }
1.5 + 0.5
null
true
let x = 1
x
--- transcript
interactive#0: 3
interactive#1: void
interactive#2: "a\"b"
interactive#3: [2,4,6]
interactive#4: 2.0
interactive#5: null
interactive#6: true
interactive#7: void
interactive#8: 1

=== inputs span lines while brackets and multi-quoted strings are open
let f(
  a: Int,
  b: Int,
): Int {
  a + b
}
f(1,
  2)
let s = """
  "two
  "lines

s
// A comment waits for what it documents.
let y = 4
y
--- transcript
interactive#0: void
interactive#1: 3
interactive#2: void
interactive#3: "two\nlines"
interactive#4: void
interactive#5: 4

=== names across inputs
let a = 1, b = 2;
a + b
class C(public n: Int) {
  public static k: Int = 10;
  public twice(): Int { n * 2 }
}
new C(3)
new C(4).twice() + C.k
interface Greeter { name(): String; greet(): String { "Hi, ${name()}" } }
class Ann extends Greeter { public name(): String { "Ann" } }
new Ann().greet()
let id<T>(x: T): T { x }
id(1)
id("one")
@staticExtension(Int, "seven") let intSeven(): Int { 7 }
Int.seven()
let { n } = new C(5);
n
{ n }
--- transcript
interactive#0: void
interactive#1: 3
interactive#2: C
interactive#3: {class: C, n: 3}
interactive#4: 18
interactive#5: Greeter
interactive#6: Ann
interactive#7: "Hi, Ann"
interactive#8: void
interactive#9: 1
interactive#10: "one"
interactive#11: void
interactive#12: 7
interactive#13: void
interactive#14: 5
interactive#15: {class: C, n: 5}

=== redefinition shadows, earlier code keeping the old
let s = "before"
let show(): String { s }
let s = "${s} then after"
s
show()
class Rectangle(public width: Float64) {}
let old = new Rectangle(1.0)
class Rectangle(public width: Float64, public height: Float64) {}
new Rectangle(2.0, 3.0)
old
{ width: 4.0, height: 5.0 }
--- transcript
interactive#0: void
interactive#1: void
interactive#2: void
interactive#3: "before then after"
interactive#4: "before"
interactive#5: Rectangle
interactive#6: void
interactive#7: Rectangle
interactive#8: {class: Rectangle, width: 2.0, height: 3.0}
interactive#9: {class: interactive#5.Rectangle, width: 1.0}
interactive#10: {class: Rectangle, width: 4.0, height: 5.0}

=== top-level vars carry over and stay typed
var v = 1
v = v + 1
v
v = "two"
v
let k = 1
k = 2
k
--- transcript
interactive#0: void
interactive#1: 2
interactive#2: 2
interactive#3:1:1: error: Cannot assign to Int32 from String
    v = "two"
    ^^^^^^^^^
interactive#3: "two"
interactive#4: "two"
interactive#5: void
interactive#6:1:1: error: Cannot assign to k, which is not a var
    k = 2
    ^
interactive#6: 2
interactive#7: 1

=== a forward reference to a later input fails; one input can recurse
let isEven(n: Int): Boolean { n == 0 || isOdd(n - 1) }
let isOdd(n: Int): Boolean { n != 0 && isEven(n - 1) }
isEven(4)
let ev(n: Int): Boolean { n == 0 || od(n - 1) }; let od(n: Int): Boolean { n != 0 && ev(n - 1) }
ev(4)
--- transcript
interactive#0:1:41: error: isOdd has not been declared
    let isEven(n: Int): Boolean { n == 0 || isOdd(n - 1) }
                                            ^^^^^
interactive#0: void
interactive#1: void
Failed: isOdd has not been declared
interactive#2: fail
interactive#3: void
interactive#4: true

=== console output comes before the result
console.log("hi"); 1
outer: for (var i = 0; i < 10; ++i) {
  for (var j = 0; j < 10; ++j) {
    if (i * j == 6) { console.log("${i} ${j}"); break outer; }
  }
}
--- transcript
hi
interactive#0: 1
1 6
interactive#1: void
