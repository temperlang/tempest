  =
  x
  (Call #desugarOperation + a (Call #desugarOperation * b c)))

=== bracketsContainingThings
do { foo(1); bar(); baz(x,++y); }
--- ast
(Call
  do
  (Fun
    (Block
      (Call foo 1)
      (Call bar)
      (Call baz x (Call #desugarOperation ++ y))
      #void)))

=== blockOfTopLevels

        do {
            let x = 0;
            while(bar()) { ++x; }
            return x;
        }
        
--- ast
(Call
  do
  (Fun
    (Block
      (Decl ^x \init 0)
      (Call while (Call bar) (Fun (Block (Call #desugarOperation ++ x) #void)))
      (Call return x)
      #void)))

=== returnOfList
return [a, b, c]
--- ast
(Call return (Call #list a b c))

=== complexIf
if (a) { x++; } else if (b) { y++; } else { z--; }
--- ast
(Call
  if
  a
  (Fun (Block (Call #desugarOperation %_++ x) #void))
  \callJoin:
  \else_if
  b
  (Fun (Block (Call #desugarOperation %_++ y) #void))
  \callJoin:
  \else
  (Fun (Block (Call #desugarOperation %_-- z) #void)))

=== whenBlock
let x = when (thing) {
  is SomeType -> thing.blah;
  someValue, other,
    is SomeOtherType -> 2;
  else -> 3;
}
--- ast
(Decl
  ^x
  \init
  (Call
    when
    thing
    (Fun
      (Block
        \case_is
        SomeType
        (Call %. thing \blah)
        \case
        someValue
        \case
        other
        \case_is
        SomeOtherType
        2
        \default
        3
        #void))))

=== postfixQuestionMarkForNullableType
let f(x: T?): T? {
  let y: T? = x;
  y
}
--- ast
(Call
  let
  \word
  ^f
  (Block \_complexArg_ x \type (Call %? T))
  \outType
  (Call %? T)
  (Fun (Block (Decl ^y \type (Call %? T) \init x) y)))

=== forLoopAllParts
for (x = 0; x < 10; ++x) { f(x); }
--- ast
(Call
  for
  \__flowInit
  (Call #desugarOperation = x 0)
  \cond
  (Call #desugarOperation < x 10)
  \incr
  (Call #desugarOperation ++ x)
  (Fun (Block (Call f x) #void)))

