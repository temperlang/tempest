    (Call #<> T u)
    (Call #desugarOperation < a b)
    (Call #desugarOperation > c d)))

=== declarationInForHeader
for (var i = 0; cond; incr) { body }
--- ast
(Call
  for
  \__flowInit
  (Call @ var (Decl ^i \init 0))
  \cond
  cond
  \incr
  incr
  (Fun (Block body)))

=== multiDeclarationInForHeader
for (var x : number = 1, n = 10; i < n; ++i) { body; }
--- ast
(Call
  for
  \__flowInit
  (Call @ var (Call #, (Decl ^x \type number \init 1) (Decl ^n \init 10)))
  \cond
  (Call #desugarOperation < i n)
  \incr
  (Call #desugarOperation ++ i)
  (Fun (Block body #void)))

=== commaExprInForInitializer
for (x = 1, y = 10; x < y; ++x, --y) { console.log(x, y); }
--- ast
(Call
  for
  \__flowInit
  (Call #, (Call #desugarOperation = x 1) (Call #desugarOperation = y 10))
  \cond
  (Call #desugarOperation < x y)
  \incr
  (Call #, (Call #desugarOperation ++ x) (Call #desugarOperation -- y))
  (Fun (Block (Call (Call %. console \log) x y) #void)))

