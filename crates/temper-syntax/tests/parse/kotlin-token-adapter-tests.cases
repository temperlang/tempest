=== constIsWeird
const x = 1;
const f() {};
const function f() {};
const public x;
public const x;
--- tree
(Semi
  (At @ const (Eq [let x] = 1))
  ;
  (At @ const (Curly (Paren [let f] "(" ")") { }))
  ;
  (At @ const (Curly (Paren [function f] "(" ")") { }))
  ;
  (At @ const (At @ public x))
  ;
  (At @ public (At @ const [let x]))
  ;)

=== visibilityWithArbitraryDecorator
public @test function f() {};
@public @test function f() {};
@test public function f() {};
@test @public function f() {};
--- tree
(Semi
  (At @ public (At @ test (Curly (Paren [function f] "(" ")") { })))
  ;
  (At @ public (At @ test (Curly (Paren [function f] "(" ")") { })))
  ;
  (At @ test (At @ public (Curly (Paren [function f] "(" ")") { })))
  ;
  (At @ test (At @ public (Curly (Paren [function f] "(" ")") { })))
  ;)

