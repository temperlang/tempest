=== infixOperatorsDoNotCallJoin
{ 0 / 0 } orelse 0;
({ prop: "value" } instanceof Thing);
--- tree
(Semi
  (OrElse (CurlyGroup { (Slash 0 / 0) }) orelse 0)
  ;
  (ParenGroup
    "("
    (Instanceof
      (CurlyGroup
        {
        (LowColon prop : (ParenGroup "(" (QuotedGroup "\"" value "\"") ")"))
        })
      instanceof
      Thing)
    ")")
  ;)

