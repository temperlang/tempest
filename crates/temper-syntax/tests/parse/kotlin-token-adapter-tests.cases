# Inputs from Kotlin Temper's parser/src/commonTest/kotlin/lang/temper/parser/
# TokenSourceAdapterTest.kt, named by test function. Expected trees are ours,
# checked against Kotlin's by compat/check_parse.py. Format and updating:
# see tests/parse.rs.

=== parensForDoubleQuotedStringTemplate
x=   " .. ${ y +   " .. ${ 0 } .. "   } .. " 
--- tree
(Eq
  x
  =
  (ParenGroup
    "("
    (QuotedGroup
      "\""
      " .. "
      (DollarCurly
        ${
        (Plus
          y
          +
          (ParenGroup
            "("
            (QuotedGroup "\"" " .. " (DollarCurly ${ 0 }) " .. " "\"")
            ")"))
        })
      " .. "
      "\"")
    ")"))

=== parensForBackQuotedStringTemplate
x=   ` .. ${ ( y +   ` .. ${ 0 } .. `   ) } .. ` 
--- tree
(Eq
  x
  =
  (ParenGroup
    "("
    (QuotedGroup
      `
      " .. "
      (DollarCurly
        ${
        (ParenGroup
          "("
          (Plus
            y
            +
            (ParenGroup
              "("
              (QuotedGroup ` " .. " (DollarCurly ${ 0 }) " .. " `)
              ")"))
          ")")
        })
      " .. "
      `)
    ")"))

=== stringTemplateWithEmbeddedStatementFragments
"""
  "some character data
  : statement(here)
  "more character${} data ${}
  "last line

+ 1  // Some trailing content to test interactions with ASI
--- tree
(Plus
  (CurlyGroup
    {
    (QuotedGroup
      "\"\"\""
      (Semi
        (PreIncr +++ "some character data\n")
        ;
        (Paren statement "(" here ")")
        ;
        (PreIncr +++ "more character")
        ;
        (PreIncr +++ " data ")
        ;
        (PreIncr +++ "\n")
        ;
        (PreIncr +++ "last line\n")
        ;)
      "\"\"\"")
    })
  +
  1)
