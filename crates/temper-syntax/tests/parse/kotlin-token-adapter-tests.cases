(Semi
  (LowColon foo : (CurlyGroup { }))
  ;
  (ParenGroup "(" x ")")
  ;
  (LowColon foo : (CurlyGroup { }))
  ;
  (Dot (SquareGroup "[" 42 "]") . bar)
  ;
  (LowColon foo : (CurlyGroup { }))
  ;
  (PrePlus + baz)
  ;)
