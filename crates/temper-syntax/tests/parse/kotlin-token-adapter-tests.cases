=== embeddedStatementExample
"""
  "<ul>
  : for (let item of items) {
  "  <li>${item}</li>\n
  : }
  "</ul>
--- tree
(CurlyGroup
  {
  (QuotedGroup
    "\"\"\""
    (Semi
      (PreIncr +++ "<ul>\n")
      ;
      (Curly
        (Paren for "(" (Of [let item] of items) ")")
        {
        (Semi
          (PreIncr +++ "  <li>")
          ;
          (DollarCurly ${ item })
          ;
          (PreIncr +++ </li>)
          ;
          (PreIncr +++ "\\n")
          ;
          (PreIncr +++ "\n")
          ;)
        })
      ;
      (PreIncr +++ </ul>)
      ;)
    "\"\"\"")
  })

=== stringInAString
"""
  "Hello,
  "${ "World" }
  "!
  ;
"World"
--- tree
(Semi
  (ParenGroup
    "("
    (QuotedGroup
      "\"\"\""
      "Hello,\n"
      (DollarCurly ${ (ParenGroup "(" (QuotedGroup "\"" World "\"") ")") })
      "\n!\n"
      "\"\"\"")
    ")")
  ;
  (ParenGroup "(" (QuotedGroup "\"" World "\"") ")"))

=== stringsOnStringTemplateLine
"""
  :for (let c of ["a", "b", "c"]) {
    ~${c},
  :}
--- tree
(CurlyGroup
  {
  (QuotedGroup
    "\"\"\""
    (Curly
      (Paren
        for
        "("
        (Of
          [let c]
          of
          (SquareGroup
            "["
            (Comma
              (ParenGroup "(" (QuotedGroup "\"" a "\"") ")")
              ,
              (ParenGroup "(" (QuotedGroup "\"" b "\"") ")")
              ,
              (ParenGroup "(" (QuotedGroup "\"" c "\"") ")"))
            "]"))
        ")")
      {
      (Semi (DollarCurly ${ c }) ; (PreIncr +++ ,) ;)
      })
    "\"\"\"")
  })

