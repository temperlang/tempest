=== asi
(
  {
    foo : {}
  }
);

x = {}
    .foo;

do {
}

while (c) {
}

else();
--- tree
(Semi
  (ParenGroup "(" (CurlyGroup { (LowColon foo : (CurlyGroup { })) }) ")")
  ;
  (Eq x = (Dot (CurlyGroup { }) . foo))
  ;
  (Curly do { })
  ;
  (Curly (Paren while "(" c ")") { })
  ;
  (Paren else "(" ")")
  ;)

=== asiIssue72
// From issue #72
foo: { }
(x); // <-- should probably stand alone as a parenthesized expression

foo: {}
[42].bar;  // <-- should probably stand alone as an operation on a list

foo: {}
+ baz;  // <-- I could go either way on this.
