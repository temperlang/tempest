=== whenBlock
when (x) {
  pattern0, pattern1                  -> consequent1();
  pattern2, pattern3 given condition1 -> consequent2();
  pattern4                            -> consequent3();
  given condition2                    -> consequent4();
  else                                -> consequent5();
}
--- tree
(Curly
  (Paren when "(" x ")")
  {
  (Semi
    (ThinArrow (Comma pattern0 , pattern1) -> (Paren consequent1 "(" ")"))
    ;
    (ThinArrow
      (InfixGiven (Comma pattern2 , pattern3) given condition1)
      ->
      (Paren consequent2 "(" ")"))
    ;
    (ThinArrow pattern4 -> (Paren consequent3 "(" ")"))
    ;
    (ThinArrow (PrefixGiven given condition2) -> (Paren consequent4 "(" ")"))
    ;
    (ThinArrow else -> (Paren consequent5 "(" ")"))
    ;)
  })

=== whenCurlyIs
when (x) {
  apple -> do {
    banana
  }
  is Cherry -> durian;
}
--- tree
(Curly
  (Paren when "(" x ")")
  {
  (Semi
    (ThinArrow apple -> (Curly do { banana }))
    ;
    (ThinArrow (PreIs is Cherry) -> durian)
    ;)
  })

=== angleBracketConfusion
or(a< 2, b>0)
--- tree
(Paren or "(" (Angle a < (Comma 2 , b) >) 0 ")")

=== postfixBang
iMightBeNull !
--- tree
(PostBang iMightBeNull !)

=== someLogicWithEmbeddedComment
return yearDelta -
   // If the end month/day is before the start's then we
   // don't have a full year.
   (monthDelta < 0 || monthDelta == 0 && end.day < start.day)
--- tree
(Return
  return
  (Dash
    yearDelta
    -
    (ParenGroup
      "("
      (BarBar
        (Lt monthDelta < 0)
        ||
        (AmpAmp
          (EqEq monthDelta == 0)
          &&
          (Lt (Dot end . day) < (Dot start . day))))
      ")")))
comment Line 22..109

=== colonLeftOfAnd
fn (Int): A & B
--- tree
(HighColon (Paren fn "(" Int ")") : (Amp A & B))

=== colonLeftOfAndNoParens
fn: A & B
--- tree
(LowColon fn : (Amp A & B))

=== selectiveColonCases
mixin("before"):
  before;
mixin("body"):
  body;
  mixin("not");
  x = BEFORE;
--- tree
(Semi
  (SelectivePostColon
    (Paren mixin "(" (ParenGroup "(" (QuotedGroup "\"" before "\"") ")") ")")
    :)
  before
  ;
  (SelectivePostColon
    (Paren mixin "(" (ParenGroup "(" (QuotedGroup "\"" body "\"") ")") ")")
    :)
  body
  ;
  (Paren mixin "(" (ParenGroup "(" (QuotedGroup "\"" not "\"") ")") ")")
  ;
  (Eq x = BEFORE)
  ;)

=== letTypedOfLoop
for (let x of elements) { body }
for (let x: T of elements) { body }
--- tree
(Semi
  (Curly (Paren for "(" (Of [let x] of elements) ")") { body })
  ;
  (Curly (Paren for "(" (Of (HighColon [let x] : T) of elements) ")") { body }))

=== ofDecoratedLet
@decoration let name: Type = expr of otherExpr
--- tree
(Of (At @ decoration (Eq (HighColon [let name] : Type) = expr)) of otherExpr)

=== keywordAfterDot
a.is
--- tree
(Dot a . is)

=== caseInArrow
match {
  case a -> f(1);
  case b(), case c() -> ...;
}
--- tree
(Curly
  match
  {
  (Semi
    (ThinArrow (PreCase case a) -> (Paren f "(" 1 ")"))
    ;
    (ThinArrow
      (Comma
        (PreCase case (Paren b "(" ")"))
        ,
        (PreCase case (Paren c "(" ")")))
      ->
      (Ellipsis ...))
    ;)
  })

=== postfixColon
let f(): T? {}
--- tree
(Curly (HighColon (Paren [let f] "(" ")") : (PostQuest T ?)) { })

=== throws2
let f(): Ok? throws Oops | Whoopsy { null }
--- tree
(Curly
  (HighColon
    (Paren [let f] "(" ")")
    :
    (Throws (PostQuest Ok ?) throws Oops | Whoopsy))
  {
  null
  })

=== emitPrefixOp
{
  +++ "foo";
  ${ bar };
}
--- tree
(CurlyGroup
  {
  (Semi
    (PreIncr +++ (ParenGroup "(" (QuotedGroup "\"" foo "\"") ")"))
    ;
    (DollarCurly ${ bar })
    ;)
  })

=== complexStringExpression
"""
  "<ul>
  : for (let item of items) {
  "  <li>${item}</li>
  : }
  "</ul>
--- tree
(CurlyGroup
  {
  (QuotedGroup
    "\"\"\""
    (Semi
      (PreIncr +++ "<ul>\n")
      ;
      (Curly
        (Paren for "(" (Of [let item] of items) ")")
        {
        (Semi
          (PreIncr +++ "  <li>")
          ;
          (DollarCurly ${ item })
          ;
          (PreIncr +++ "</li>\n")
          ;)
        })
      ;
      (PreIncr +++ </ul>)
      ;)
    "\"\"\"")
  })

