  })

=== positions

        function fib(i) {
          let a = 0; 
          let b = 1;
          while (i > 0) {
            let c = a + b;
            a = b;
            b = c;
          }
          a;
        }
        fib(8);
--- tree
(Semi
  (Curly
    (Paren [function fib] "(" i ")")
    {
    (Semi
      (Eq [let a] = 0)
      ;
      (Eq [let b] = 1)
      ;
      (Curly
        (Paren while "(" (Gt i > 0) ")")
        {
        (Semi (Eq [let c] = (Plus a + b)) ; (Eq a = b) ; (Eq b = c) ;)
        })
      ;
      a
      ;)
    })
  ;
  (Paren fib "(" 8 ")")
  ;)

=== givenBlock
given {
  condition1 -> consequent1();
  condition2 -> consequent2();
  else       -> consequent3();
}
--- tree
(PrefixGiven
  given
  (CurlyGroup
    {
    (Semi
      (ThinArrow condition1 -> (Paren consequent1 "(" ")"))
      ;
      (ThinArrow condition2 -> (Paren consequent2 "(" ")"))
      ;
      (ThinArrow else -> (Paren consequent3 "(" ")"))
      ;)
    }))

