export let wrap(text: String, open: String = "[", close: String = open): String {
  "${open}${text}${close}"
}

export class Pad(public left: Int = 1, public right: Int = 2) {
  public apply(text: String, fill: String = "."): String {
    var out = text;
    for (var i = 0; i < left; i += 1) {
      out = "${fill}${out}";
    }
    for (var i = 0; i < right; i += 1) {
      out = "${out}${fill}";
    }
    out
  }
}
