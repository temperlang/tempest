{
  "name": "temper",
  "displayName": "Temper",
  "description": "Temper in VS Code: highlighting for .temper and literate .temper.md files, a rendered preview of .temper.md, and tempest's language server for errors as you type, hover, go to definition, completion, references, rename, outlines, and signature help",
  "version": "0.0.1",
  "publisher": "temperlang",
  "license": "Apache-2.0 OR MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/temperlang/tempest"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "temper",
        "aliases": [
          "Temper"
        ],
        "extensions": [
          ".temper"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "temper-markdown",
        "aliases": [
          "Temper Markdown",
          "Literate Temper"
        ],
        "extensions": [
          ".temper.md"
        ],
        "configuration": "./markdown-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "temper",
        "scopeName": "source.temper",
        "path": "./syntaxes/temper.tmLanguage.json"
      },
      {
        "language": "temper-markdown",
        "scopeName": "text.html.markdown.temper",
        "path": "./syntaxes/temper-markdown.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.temper": "temper"
        }
      }
    ],
    "colors": [
      {
        "id": "temper.inertBlockBackground",
        "description": "Background of a temper inert block's lines in .temper.md: Temper shown for reading, not compiled.",
        "defaults": {
          "light": "#80808014",
          "dark": "#8080801c",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "temper.inertLabelForeground",
        "description": "The \"inert\" label after a temper inert block's opening fence.",
        "defaults": {
          "light": "descriptionForeground",
          "dark": "descriptionForeground",
          "highContrast": "descriptionForeground",
          "highContrastLight": "descriptionForeground"
        }
      }
    ],
    "configuration": {
      "title": "Temper",
      "properties": {
        "temper.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `tempest` that runs the language server (`tempest lsp`): a name on `PATH` or a full path. Empty uses the `tempest` bundled with this extension, if it has one, and else `tempest` on `PATH`."
        },
        "temper.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "More arguments after `tempest lsp`, as `[\"--std\", \"/path/to/std\"]`."
        }
      }
    },
    "commands": [
      {
        "command": "temper.restartServer",
        "title": "Temper: Restart Language Server"
      },
      {
        "command": "temper.showPreview",
        "title": "Open Markdown Preview",
        "category": "Temper",
        "icon": "$(open-preview)"
      },
      {
        "command": "temper.showPreviewToSide",
        "title": "Open Markdown Preview to the Side",
        "category": "Temper",
        "icon": "$(open-preview)"
      }
    ],
    "keybindings": [
      {
        "command": "temper.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == temper-markdown"
      },
      {
        "command": "temper.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == temper-markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "temper.showPreviewToSide",
          "when": "editorLangId == temper-markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "temper.showPreview",
          "when": "resourceLangId == temper-markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "temper.showPreview",
          "when": "editorLangId == temper-markdown"
        },
        {
          "command": "temper.showPreviewToSide",
          "when": "editorLangId == temper-markdown"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vscode-languageclient": "11.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
