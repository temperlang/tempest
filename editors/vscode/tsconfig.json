{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": [
    "src/extension.ts",
    "src/server.test.ts",
    "src/node.d.ts",
    "test/suite.ts",
    "test/run.ts",
    "node_modules/@types/vscode/index.d.ts"
  ]
}
