Annotate be-py's new promises and std/net's futures as TemperFuture, so strict checkers take a bare await of them.
Upstream: not yet; to offer Kotlin Temper with patch 0007.

`TemperFuture` subclasses `Future` and has `__await__`, so a
`Future`-typed caller is unchanged.

diff --git a/be-py/temper-core/temper_core/__init__.py b/be-py/temper-core/temper_core/__init__.py
index 61bd83c..5b4ec17 100644
--- a/be-py/temper-core/temper_core/__init__.py
+++ b/be-py/temper-core/temper_core/__init__.py
@@ -1237,12 +1237,12 @@ _nbuT = TypeVar("_nbuT")
 
 
 # Support for Temper `new PromiseBuilder()`.
-def new_unbound_promise() -> Future[_nbuT]:  # FTS [T] -> Future[T]
+def new_unbound_promise() -> TemperFuture[_nbuT]:  # FTS [T] -> Future[T]
     global _unresolved_count
     with _unresolved_count_lock:
         _unresolved_count += 1
         _all_resolved.clear()
-    p: Future[_nbuT] = TemperFuture()  # FTS [T]
+    p: TemperFuture[_nbuT] = TemperFuture()  # FTS [T]
     p.add_done_callback(lambda _: _decrement_unresolved_count())
     return p
 
@@ -1404,7 +1404,7 @@ class NetResponse:
         self,
         status: int,
         headers: Dict[str, str],
-        body: Future[str],
+        body: TemperFuture[str],
     ):
         self.status = status
         self.headers = headers
@@ -1415,7 +1415,7 @@ class NetResponse:
         return self.headers["content-type"]
 
     @property
-    def text(self) -> Future[str]:
+    def text(self) -> TemperFuture[str]:
         return self._body
 
 
@@ -1425,7 +1425,7 @@ def std_net_send(
     method: str,
     body_content: Optional[str],
     body_mime_type: Optional[str],
-) -> Future[NetResponse]:
+) -> TemperFuture[NetResponse]:
     # TODO: use aiohttp for truly asynchronous fetching
     # This is good enough for the infrequent client use case.
     data = None
@@ -1435,8 +1435,8 @@ def std_net_send(
     if body_mime_type is not None:
         headers["content-type"] = body_mime_type
     request = urllib.request.Request(url, data, headers, method=method)
-    net_response_future: Future[NetResponse] = new_unbound_promise()
-    body_future: Future[str] = new_unbound_promise()
