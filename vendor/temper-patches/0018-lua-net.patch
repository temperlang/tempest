+        local coro_create = coroutine.create
+        local coro_status = coroutine.status
+        local table_insert = table.insert
+        -- Requests in flight, each a coroutine running `http.request` over
+        -- a socket that yields instead of blocking: waiting[co] is the
+        -- socket and whether it waits to read ("r") or write ("w").
+        local waiting = {}
+        local count = 0
+        local source_added = false
+
+        local function step(co)
+            waiting[co] = nil
+            local ok_step, sock, mode = coro_resume(co)
+            if not ok_step then
+                error(sock, 0)
+            elseif coro_status(co) ~= "dead" then
+                waiting[co] = { sock = sock, mode = mode }
+            end
+        end
+
+        -- A TCP socket for `http.request` whose waits yield to the source
+        -- below, so a request never blocks a turn or other requests.
+        local function yielding(tcp)
+            tcp:settimeout(0)
+            local wrapper = {}
+            function wrapper:settimeout()
+                return 1
+            end
+            function wrapper:connect(host, port)
+                local done, err = tcp:connect(host, port)
+                while not done do
+                    if err ~= "timeout" and err ~= "Operation already in progress" then
+                        if err == "already connected" then
+                            return 1
+                        end
+                        return nil, err
+                    end
+                    coro_yield(tcp, "w")
+                    done, err = tcp:connect(host, port)
+                end
