+                local from = i or 1
+                while true do
+                    local sent, err, last_sent = tcp:send(data, from, j)
+                    if sent then
+                        return sent
+                    elseif err ~= "timeout" then
+                        return nil, err, last_sent
+                    end
+                    from = last_sent + 1
+                    coro_yield(tcp, "w")
+                end
+            end
