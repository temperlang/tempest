Let be-lua's generators yield values and take their factory's arguments.
Upstream: not yet; to offer Kotlin Temper with patch 0011 (Kotlin's TmpL drops yield(x)'s value).

`temper.yield` dropped what it was given, so a generator gave Lua's
`for` loops only `true`; it now passes its arguments to
`coroutine.yield`. `adapt_generator_fn`'s factory ignored its arguments
(its TODO); it now gives them to the generator function when the first
step starts it.

diff --git a/be-lua/temper-core/init.lua b/be-lua/temper-core/init.lua
index 3421a03..25330bb 100644
--- a/be-lua/temper-core/init.lua
+++ b/be-lua/temper-core/init.lua
@@ -235,8 +235,8 @@ do
     end
 end
 
-function temper.yield()
-    coro_yield()
+function temper.yield(...)
+    coro_yield(...)
 end
 
 -- A generator is a coroutine behind a callable table. Calling it steps
@@ -267,11 +267,13 @@ generator_meta.__call = function(self)
 end
 
 function temper.adapt_generator_fn(f)
-    -- TODO: how do we forwards args to f on initial call?
-    -- Do we need a wrapper from the translator instead of
-    -- wrapping here?
-    return function()
-        return setmetatable({ co = coroutine.create(f) }, generator_meta)
+    -- The factory's arguments go to `f` when the first step starts it.
+    return function(...)
+        local n, args = select("#", ...), { ... }
+        local co = coroutine.create(function()
+            return f(table_unpack(args, 1, n))
+        end)
+        return setmetatable({ co = co }, generator_meta)
     end
 end
 
