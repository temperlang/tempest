// A lazy sequence
// A generator runs a step at a time: each `yield` hands
// a value to whoever asked for the next, and waits. So
// `fibonacci` goes on forever, and `take` asks for only
// as many values as it needs.

/** A generator, from a block that extends `GeneratorFn`. */
let generated<T>(make: fn (): SafeGenerator<T>): SafeGenerator<T> {
  make()
}

/** Every Fibonacci number, one per step. */
export let fibonacci(): SafeGenerator<Int> {
  generated { (): GeneratorResult<Int> extends GeneratorFn =>
    var a = 0;
    var b = 1;
    while (true) {
      yield(a);
      let next = a + b;
      a = b;
      b = next;
    }
  }
}

/** Up to `n` values, fewer if the generator ends first. */
export let take(numbers: SafeGenerator<Int>, n: Int): List<Int> {
  let taken = new ListBuilder<Int>();
  while (taken.length < n) {
    let step = numbers.nextSafe();
    if (step is ValueResult<Int>) {
      taken.add(step.value);
    } else {
      break;
    }
  }
  taken.toList()
}

let joined(numbers: List<Int>): String {
  numbers.join(", ") { (n: Int): String => n.toString() }
}

test("takes only what it asks for") {
  let numbers = fibonacci();
  assert(joined(take(numbers, 5)) == "0, 1, 1, 2, 3");
  // The rest wait where the last step left off.
  assert(joined(take(numbers, 3)) == "5, 8, 13");
}

console.log(joined(take(fibonacci(), 12)));
